# 输出目录（视频、字幕、封面等）
output/

# Python 缓存
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# 虚拟环境
venv/
.venv/
env/

# 系统文件
.DS_Store
*.swp
*.swo

# Cookie 文件（包含登录凭证，不提交）
cookies.txt
*.netscape
bilibili.com.txt

# 登录态/凭证目录（CI 从 Secrets 写入，绝不提交）
secrets/
cookies.json
*_cookies.json
*_cookies.txt

# biliup 配置（可能含账号信息）
biliup.toml

# 日志
*.log

# 临时文件
*.tmp
*.bak

# 端到端验证临时文件
_e2e_test/
output/

# LLM/VLM 响应缓存（内容寻址，本地与 CI 各自持有，不进版本库）
.llm_cache/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example
