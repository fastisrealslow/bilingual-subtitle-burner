{
  "bvid": "BV1vepj6eE1V",
  "release_final": "ly-1009-b60450.final_7.mp4",
  "sha256": "8beaa3c84d811b8a846d23b0388638b4ea1f150ef302be5cc476b86b9646846b",
  "raw_text_sha256": "327c06abc8ab50f56e0af0b32a6f3041325d805b5b266f932647df0bc539d69f",
  "cues": [
    {
      "start": 0.0,
      "end": 3.6799999999999926,
      "text": "您觉得现在投资AI是需要承担百分之九"
    },
    {
      "start": 3.6799999999999926,
      "end": 4.799999999999997,
      "text": "十九点八的风险？"
    },
    {
      "start": 5.359999999999999,
      "end": 7.599999999999994,
      "text": "甚至百分之一百。我说的是百分之一百。"
    },
    {
      "start": 9.679999999999993,
      "end": 13.519999999999996,
      "text": "因为从过去几十年看，科技公司啊，"
    },
    {
      "start": 13.759999999999991,
      "end": 16.72,
      "text": "真正能存活下来的，就你投。"
    },
    {
      "start": 16.72,
      "end": 20.47999999999999,
      "text": "你比如说，你今年投到多少年以后能存活"
    },
    {
      "start": 20.47999999999999,
      "end": 20.879999999999995,
      "text": "下来的？"
    },
    {
      "start": 22.39999999999999,
      "end": 23.75999999999999,
      "text": "我看一个都没有。"
    },
    {
      "start": 26.879999999999995,
      "end": 29.359999999999985,
      "text": "就等你想投的时候，已经是成熟的公司。"
    },
    {
      "start": 30.799999999999983,
      "end": 32.72,
      "text": "最后再遇到一个，"
    },
    {
      "start": 34.16,
      "end": 36.400000000000006,
      "text": "他经营不好的时候，或者这个产品过时的"
    },
    {
      "start": 36.400000000000006,
      "end": 37.75999999999999,
      "text": "时候，或者方向选错了，"
    },
    {
      "start": 40.24000000000001,
      "end": 41.44,
      "text": "都会是致命的。"
    },
    {
      "start": 41.75999999999999,
      "end": 44.400000000000006,
      "text": "就没有，就是我们作为一个投资人，"
    },
    {
      "start": 44.400000000000006,
      "end": 46.0,
      "text": "我们到底要投什么样的东西？"
    },
    {
      "start": 46.56,
      "end": 50.0,
      "text": "我就喜欢投了，赚了钱你就往兜里放，"
    },
    {
      "start": 50.16,
      "end": 50.96000000000001,
      "text": "不需要再投入。"
    },
    {
      "start": 51.599999999999994,
      "end": 54.24000000000001,
      "text": "它是这样，长期的话，就说就是我"
    },
    {
      "start": 55.599999999999994,
      "end": 57.68000000000001,
      "text": "们，呃呃，国内这个AI这个行业，"
    },
    {
      "start": 58.16,
      "end": 60.16,
      "text": "它的这个公司的竞争力。"
    },
    {
      "start": 61.120000000000005,
      "end": 64.24000000000001,
      "text": "我相我还是相信中国公司的这个竞争力，"
    },
    {
      "start": 65.6,
      "end": 67.44,
      "text": "很厉害，没有问题。"
    },
    {
      "start": 67.75999999999999,
      "end": 70.4,
      "text": "长期是，但短期它波动，"
    },
    {
      "start": 73.19999999999999,
      "end": 76.22,
      "text": "短期比如说它下跌，会有情绪上的影响。"
    },
    {
      "start": 76.32,
      "end": 79.84,
      "text": "啊，而且短期这个影响还比较大。"
    },
    {
      "start": 83.19999999999999,
      "end": 86.88,
      "text": "那其实承接着这个风险的这个话题哈，"
    },
    {
      "start": 86.88,
      "end": 90.47999999999999,
      "text": "我我知道您本人有一个比较特别的这个真"
    },
    {
      "start": 90.47999999999999,
      "end": 93.91999999999999,
      "text": "实的经历，就是虽然您说坚决不碰科技股，"
    },
    {
      "start": 93.91999999999999,
      "end": 96.16,
      "text": "但是后来还是没有忍住买了一点，"
    },
    {
      "start": 96.63999999999999,
      "end": 99.68,
      "text": "然后结果您是坦言就是愁到睡不着觉。"
    }
  ]
}