  "cues": [
    {"start":300.52,"end":303.4,"text":"那个，嗯，今天讲课的是吧？","caption_chars":[["那",300.52,300.6],["个",300.6,300.84],["，",300.84,300.84],["嗯",301.4,301.64],["，",301.64,301.64],["今",301.72,301.8],["天",301.8,302.12],["讲",302.12,302.28],["课",302.36,302.6],["的",302.6,302.76],["是",303.08,303.24],["吧",303.24,303.4],["？",303.4,303.4]]},
    {"start":304.04,"end":306.36,"text":"但是我刚才有一个人，有一个小伙子。","caption_chars":[["但",304.04,304.12],["是",304.12,304.2],["我",304.2,304.44],["刚",304.44,304.68],["才",304.68,304.92],["有",304.92,305.24],["一",305.24,305.24],["个",305.24,305.32],["人",305.32,305.48],["，",305.48,305.48],["有",305.56,305.72],["一",305.72,305.72],["个",305.72,305.8],["小",305.8,306.04],["伙",306.04,306.2],["子",306.2,306.36],["。",306.36,306.36]]},
    {"start":307.8,"end":309.8,"text":"他让我签书，他说是这个，","caption_chars":[["他",307.8,307.96],["让",307.96,308.12],["我",308.12,308.2],["签",308.2,308.52],["书",308.52,308.76],["，",308.76,308.76],["他",308.76,308.92],["说",308.92,309.16],["是",309.16,309.32],["这",309.56,309.64],["个",309.64,309.8],["，",309.8,309.8]]},
    {"start":311.0,"end":313.72,"text":"好像零几年、零七年啊什么时候。","caption_chars":[["好",311.0,311.16],["像",311.16,311.32],["零",311.56,311.72],["几",311.72,311.96],["年",311.96,312.2],["、",312.2,312.2],["零",312.76,312.84],["七",312.84,313.08],["年",313.08,313.16],["啊",313.16,313.32],["什",313.32,313.48],["么",313.48,313.56],["时",313.56,313.64],["候",313.64,313.72],["。",313.72,313.72]]},
    {"start":314.52,"end":318.12,"text":"啊，他听过我讲讲座，在这也是在北大。","caption_chars":[["啊",314.52,314.68],["，",314.68,314.68],["他",314.68,314.76],["听",314.84,315.0],["过",315.0,315.16],["我",315.16,315.32],["讲",315.32,315.4],["讲",315.64,315.72],["座",316.28,316.52],["，",316.52,316.52],["在",316.92,317.08],["这",317.08,317.24],["也",317.24,317.48],["是",317.48,317.64],["在",317.64,317.72],["北",317.72,317.88],["大",317.96,318.12],["。",318.12,318.12]]},
    {"start":319.72,"end":321.08,"text":"为什么这个时候我愿意","caption_chars":[["为",319.72,319.8],["什",319.8,319.88],["么",319.88,320.04],["这",320.04,320.12],["个",320.12,320.28],["时",320.28,320.36],["候",320.36,320.44],["我",320.44,320.6],["愿",320.6,320.84],["意",320.84,321.08]]},
    {"start":322.6,"end":325.72,"text":"把这个信息啊告诉？","caption_chars":[["把",322.6,322.68],["这",322.68,322.84],["个",322.84,323.64],["信",324.52,324.84],["息",324.84,325.08],["啊",325.08,325.24],["告",325.4,325.56],["诉",325.56,325.72],["？",325.72,325.72]]},
    {"start":326.2,"end":329.64,"text":"那么从去年九月份到现在，是让我们组织","caption_chars":[["那",326.2,326.28],["么",326.28,326.36],["从",326.36,326.52],["去",326.52,326.76],["年",326.76,326.84],["九",326.84,327.08],["月",327.08,327.24],["份",327.24,327.56],["到",327.88,328.04],["现",328.04,328.2],["在",328.2,328.44],["，",328.44,328.44],["是",328.6,329.0],["让",329.0,329.08],["我",329.08,329.15999999999997],["们",329.15999999999997,329.32],["组",329.32,329.48],["织",329.48,329.64]]},
    {"start":329.64,"end":332.84,"text":"了很多次活动，我见的人超过五千人。","caption_chars":[["了",329.64,329.64],["很",329.64,329.8],["多",329.96,330.12],["次",330.12,330.36],["活",330.36,330.36],["动",330.36,330.68],["，",330.68,330.68],["我",331.16,331.32],["见",331.32,331.48],["的",331.48,331.64],["人",331.64,331.8],["超",331.96,332.2],["过",332.2,332.28],["五",332.28,332.52],["千",332.52,332.76],["人",332.76,332.84],["。",332.84,332.84]]},
    {"start":334.28,"end":334.6,"text":"为什么？","caption_chars":[["为",334.28,334.36],["什",334.36,334.52],["么",334.52,334.6],["？",334.6,334.6]]},
    {"start":335.48,"end":340.52,"text":"那就是我觉得这个位置啊，是能让人有磨","caption_chars":[["那",335.48,335.64],["就",335.64,335.72],["是",335.72,335.96],["我",336.28,336.44],["觉",336.44,336.6],["得",336.6,336.76],["这",336.76,336.92],["个",336.92,337.0],["位",337.08,337.24],["置",337.24,337.48],["啊",337.48,337.96],["，",337.96,337.96],["是",338.36,338.84],["能",338.92,339.16],["让",339.16,339.32],["人",339.32,339.64],["有",339.8,340.12],["磨",340.2,340.52]]},
    {"start":340.52,"end":344.28,"text":"难，最后能让人能够记得起来的事儿。","caption_chars":[["难",340.52,341.0],["，",341.0,341.0],["最",341.24,341.4],["后",341.4,341.64],["能",341.64,342.04],["让",342.04,342.2],["人",342.2,342.44],["能",342.92,343.0],["够",343.0,343.16],["记",343.16,343.4],["得",343.4,343.48],["起",343.48,343.8],["来",343.8,343.96],["的",343.96,344.04],["事",344.04,344.2],["儿",344.2,344.28],["。",344.28,344.28]]},
    {"start":345.88,"end":348.44,"text":"一生当中啊，能够记起记得起来。","caption_chars":[["一",345.88,346.04],["生",346.04,346.28],["当",346.28,346.44],["中",346.44,346.6],["啊",346.6,346.76],["，",346.76,346.76],["能",346.76,346.84],["够",346.84,347.0],["记",347.0,347.16],["起",347.16,347.4],["记",347.8,347.88],["得",347.88,348.04],["起",348.04,348.28],["来",348.28,348.44],["。",348.44,348.44]]},
    {"start":351.48,"end":355.96,"text":"那么我现在的判断是，过了时间不长的时","caption_chars":[["那",351.48,351.56],["么",351.56,351.64],["我",351.64,351.88],["现",351.88,352.04],["在",352.04,352.2],["的",352.2,352.28],["判",352.28,352.52],["断",352.52,352.68],["是",353.0,353.16],["，",353.16,353.16],["过",353.88,354.04],["了",354.04,354.36],["时",354.68,354.92],["间",354.92,355.16],["不",355.24,355.4],["长",355.4,355.72],["的",355.72,355.8],["时",355.8,355.96]]},
    {"start":355.96,"end":359.4,"text":"候，你们会想起我曾经在这个时候说过一","caption_chars":[["候",355.96,356.04],["，",356.04,356.04],["你",356.04,356.2],["们",356.2,356.28],["会",356.28,356.44],["想",356.44,356.84],["起",356.84,357.08],["我",357.48,357.64],["曾",357.64,357.96],["经",357.96,358.2],["在",358.2,358.36],["这",358.36,358.52],["个",358.52,358.68],["时",358.68,358.76],["候",358.76,358.92],["说",358.92,359.15999999999997],["过",359.15999999999997,359.4],["一",359.4,359.4]]},
    {"start":359.4,"end":360.04,"text":"些话。","caption_chars":[["些",359.4,359.56],["话",359.56,360.04],["。",360.04,360.04]]},
    {"start":361.24,"end":366.28,"text":"我也这个人讲，我就想把我们的这个现在","caption_chars":[["我",361.24,361.24],["也",361.24,361.48],["这",361.64,361.72],["个",361.72,361.8],["人",361.8,361.96],["讲",361.96,362.28],["，",362.28,362.28],["我",362.68,362.84],["就",362.84,362.92],["想",362.92,363.16],["把",363.16,363.4],["我",364.36,364.52],["们",364.52,364.6],["的",364.6,364.76],["这",364.76,364.84],["个",364.84,365.0],["现",365.8,366.04],["在",366.04,366.28]]},
    {"start":366.28,"end":370.12,"text":"我们的这些想法，对市场的一些看法，","caption_chars":[["我",366.28,366.44],["们",366.44,366.6],["的",367.24,367.24],["这",367.24,367.4],["些",367.4,367.56],["想",367.56,367.96],["法",367.96,368.2],["，",368.2,368.2],["对",368.84,369.0],["市",369.0,369.16],["场",369.16,369.4],["的",369.4,369.48],["一",369.48,369.48],["些",369.48,369.64],["看",369.64,369.88],["法",369.88,370.12],["，",370.12,370.12]]},
    {"start":370.44,"end":373.56,"text":"我要说出来，我看看到时候能不能印证我","caption_chars":[["我",370.44,370.52],["要",370.52,370.6],["说",370.6,370.84],["出",370.84,371.0],["来",371.0,371.08],["，",371.08,371.08],["我",371.4,371.48],["看",371.48,371.64],["看",371.64,371.72],["到",371.72,371.96],["时",371.96,372.04],["候",372.04,372.12],["能",372.52,372.68],["不",372.68,372.84],["能",372.84,372.92],["印",372.92,373.16],["证",373.16,373.48],["我",373.48,373.56]]},
    {"start":373.56,"end":374.28,"text":"当时说的","caption_chars":[["当",373.56,373.8],["时",373.8,373.96],["说",373.96,374.2],["的",374.2,374.28]]},
    {"start":375.64,"end":376.2,"text":"一些东西。","caption_chars":[["一",375.64,375.64],["些",375.64,375.72],["东",375.72,375.96],["西",375.96,376.2],["。",376.2,376.2]]},
    {"start":377.16,"end":379.72,"text":"啊，这也是你说有目的吧，也是有目的。","caption_chars":[["啊",377.16,377.4],["，",377.4,377.4],["这",377.64,377.8],["也",377.8,377.88],["是",377.88,378.12],["你",378.12,378.28],["说",378.28,378.36],["有",378.36,378.52],["目",378.52,378.76],["的",378.76,378.84],["吧",378.84,379.0],["，",379.0,379.0],["也",379.0,379.16],["是",379.16,379.32],["有",379.32,379.48],["目",379.48,379.64],["的",379.64,379.72],["。",379.72,379.72]]},
    {"start":380.12,"end":383.56,"text":"但如果今天这个位置，如果我觉得不该说","caption_chars":[["但",380.12,380.28],["如",380.28,380.44],["果",380.44,380.6],["今",380.6,380.76],["天",380.76,381.0],["这",381.0,381.08],["个",381.08,381.16],["位",381.16,381.32],["置",381.32,381.56],["，",381.56,381.56],["如",382.04,382.12],["果",382.12,382.28],["我",382.28,382.44],["觉",382.44,382.68],["得",382.68,383.0],["不",383.0,383.08],["该",383.08,383.4],["说",383.4,383.56]]},
    {"start":383.56,"end":384.44,"text":"这个话的时候，","caption_chars":[["这",383.56,383.72],["个",383.72,383.8],["话",383.8,384.04],["的",384.04,384.2],["时",384.2,384.28],["候",384.28,384.44],["，",384.44,384.44]]},
    {"start":385.8,"end":388.92,"text":"我可能什么都不说，甚至前两年，","caption_chars":[["我",385.8,385.8],["可",385.88,386.04],["能",386.04,386.12],["什",386.12,386.2],["么",386.2,386.36],["都",386.36,386.44],["不",386.44,386.6],["说",386.6,386.84],["，",386.84,386.84],["甚",387.4,387.56],["至",387.56,387.72],["前",388.12,388.36],["两",388.36,388.52],["年",388.52,388.92],["，",388.92,388.92]]},
    {"start":389.24,"end":391.64,"text":"我记得两两两年前还是三年前，","caption_chars":[["我",389.24,389.4],["记",389.4,389.56],["得",389.56,389.64],["两",389.72,389.88],["两",390.04,390.2],["两",390.44,390.6],["年",390.6,390.76],["前",390.76,391.0],["还",391.0,391.08],["是",391.08,391.16],["三",391.16,391.32],["年",391.32,391.48],["前",391.48,391.64],["，",391.64,391.64]]},
    {"start":392.44,"end":395.88,"text":"也是一个线上的会议，说是有很多人参加。","caption_chars":[["也",392.44,392.68],["是",392.68,392.92],["一",392.92,393.64],["个",393.64,393.72],["线",393.72,393.96],["上",393.96,394.04],["的",394.04,394.2],["会",394.2,394.36],["议",394.36,394.52],["，",394.52,394.52],["说",394.52,394.76],["是",394.76,394.92],["有",394.92,395.0],["很",395.16,395.16],["多",395.24,395.4],["人",395.4,395.48],["参",395.48,395.64],["加",395.64,395.88],["。",395.88,395.88]]},
    {"start":397.72,"end":399.96,"text":"那时候问我，我我说我都不知道，","caption_chars":[["那",397.72,397.8],["时",397.8,397.96],["候",397.96,398.04],["问",398.12,398.2],["我",398.2,398.68],["，",398.68,398.68],["我",399.08,399.08],["我",399.08,399.16],["说",399.16,399.32],["我",399.32,399.48],["都",399.48,399.56],["不",399.56,399.72],["知",399.72,399.88],["道",399.88,399.96],["，",399.96,399.96]]},
    {"start":400.68,"end":405.32,"text":"啊，我说你们呃，这个投资要这个这个注","caption_chars":[["啊",400.68,401.0],["，",401.0,401.0],["我",401.4,401.48],["说",401.48,401.64],["你",401.64,401.72],["们",401.72,401.96],["呃",402.68,403.0],["，",403.0,403.0],["这",403.0,403.16],["个",403.16,403.56],["投",403.64,403.88],["资",403.88,403.96],["要",403.96,404.12],["这",404.36,404.44],["个",404.44,404.6],["这",404.6,404.76],["个",404.76,405.0],["注",405.16,405.32]]},
    {"start":405.32,"end":405.8,"text":"意风险。","caption_chars":[["意",405.32,405.4],["风",405.4,405.64],["险",405.64,405.8],["。",405.8,405.8]]},
    {"start":407.4,"end":408.36,"text":"啊，亏了，活该。","caption_chars":[["啊",407.4,407.72],["，",407.72,407.72],["亏",407.72,407.88],["了",407.88,407.96],["，",407.96,407.96],["活",408.12,408.12],["该",408.12,408.36],["。",408.36,408.36]]},
    {"start":409.56,"end":413.08,"text":"结果是媒体就报道出去说：我对投资人说","caption_chars":[["结",409.56,409.64],["果",409.64,409.8],["是",409.8,409.88],["媒",409.88,410.12],["体",410.12,410.28],["就",410.28,410.36],["报",410.36,410.6],["道",410.6,410.76],["出",410.76,411.0],["去",411.0,411.16],["说",411.16,411.32],["：",411.32,411.32],["我",411.88,411.88],["对",411.88,412.2],["投",412.52,412.68],["资",412.68,412.84],["人",412.84,412.92],["说",412.92,413.08]]},
    {"start":413.08,"end":413.96,"text":"是亏了，活该。","caption_chars":[["是",413.08,413.24],["亏",413.24,413.48],["了",413.48,413.56],["，",413.56,413.56],["活",413.56,413.72],["该",413.72,413.96],["。",413.96,413.96]]},
    {"start":414.76,"end":416.04,"text":"我说：那是提起风险。","caption_chars":[["我",414.76,414.84],["说",414.84,415.0],["：",415.0,415.0],["那",415.0,415.08],["是",415.08,415.24],["提",415.24,415.48],["起",415.48,415.64],["风",415.64,415.88],["险",415.88,416.04],["。",416.04,416.04]]},
    {"start":417.0,"end":418.04,"text":"啊，他这个","caption_chars":[["啊",417.0,417.24],["，",417.24,417.24],["他",417.64,417.8],["这",417.8,417.88],["个",417.88,418.04]]},
    {"start":419.08,"end":422.92,"text":"投资啊，实际上际上，你要说真正的投资","caption_chars":[["投",419.08,419.32],["资",419.32,419.48],["啊",419.48,419.72],["，",419.72,419.72],["实",419.72,419.88],["际",419.88,419.96],["上",419.96,420.04],["际",420.04,420.04],["上",420.04,420.04],["，",420.04,420.04],["你",420.6,420.76],["要",420.76,420.92],["说",420.92,421.16],["真",421.8,422.04],["正",422.04,422.2],["的",422.28,422.28],["投",422.28,422.68],["资",422.68,422.92]]},
    {"start":422.92,"end":424.84,"text":"是什么含义？我的理解就是。","caption_chars":[["是",422.92,423.08],["什",423.08,423.24],["么",423.24,423.4],["含",423.4,423.64],["义",423.64,423.8],["？",423.8,423.8],["我",423.88,424.04],["的",424.04,424.2],["理",424.2,424.44],["解",424.44,424.6],["就",424.6,424.68],["是",424.68,424.84],["。",424.84,424.84]]},
    {"start":426.84,"end":430.84,"text":"在抓住时机的基础上，有强大的理论去支","caption_chars":[["在",426.84,427.0],["抓",427.0,427.4],["住",427.4,427.64],["时",427.64,427.96],["机",427.96,428.2],["的",428.2,428.28],["基",428.28,428.52],["础",428.52,428.68],["上",428.68,428.84],["，",428.84,428.84],["有",429.16,429.32],["强",429.32,429.72],["大",429.72,429.96],["的",429.96,430.12],["理",430.12,430.28],["论",430.28,430.44],["去",430.52,430.6],["支",430.6,430.84]]},
    {"start":430.84,"end":432.68,"text":"持它，这个时候就该投资。","caption_chars":[["持",430.84,431.0],["它",431.0,431.24],["，",431.24,431.24],["这",431.48,431.56],["个",431.56,431.64],["时",431.64,431.8],["候",431.8,431.88],["就",431.88,431.96],["该",431.96,432.2],["投",432.2,432.44],["资",432.44,432.68],["。",432.68,432.68]]},
    {"start":435.4,"end":436.2,"text":"这就是他们，","caption_chars":[["这",435.4,435.56],["就",435.56,435.72],["是",435.72,435.8],["他",435.8,435.96],["们",435.96,436.2],["，",436.2,436.2]]},
    {"start":437.8,"end":439.96,"text":"传统意义上我们讲的就是价值。","caption_chars":[["传",437.8,438.12],["统",438.12,438.2],["意",438.2,438.28],["义",438.28,438.44],["上",438.44,438.6],["我",438.6,438.84],["们",438.84,438.92],["讲",438.92,439.16],["的",439.16,439.24],["就",439.24,439.4],["是",439.4,439.56],["价",439.56,439.8],["值",439.88,439.96],["。",439.96,439.96]]},
    {"start":441.0,"end":444.92,"text":"它价值包括很多，啊，抓住时机就是我们","caption_chars":[["它",441.0,441.08],["价",441.08,441.32],["值",441.32,441.48],["包",441.56,441.64],["括",441.64,441.88],["很",441.88,442.04],["多",442.12,442.28],["，",442.28,442.28],["啊",443.08,443.24],["，",443.24,443.24],["抓",443.56,443.72],["住",443.72,443.96],["时",443.96,444.2],["机",444.2,444.36],["就",444.36,444.52],["是",444.52,444.68],["我",444.68,444.84],["们",444.84,444.92]]},
    {"start":445.24,"end":447.8,"text":"作为一个投资人的最基本的，就抓住时机。","caption_chars":[["作",445.24,445.4],["为",445.4,445.48],["一",445.48,445.56],["个",445.56,445.64],["投",445.64,445.88],["资",445.88,446.04],["人",446.04,446.2],["的",446.2,446.2],["最",446.2,446.44],["基",446.44,446.6],["本",446.6,446.68],["的",446.68,446.84],["，",446.84,446.84],["就",446.84,447.0],["抓",447.0,447.24],["住",447.24,447.32],["时",447.32,447.56],["机",447.56,447.8],["。",447.8,447.8]]},
    {"start":449.08,"end":452.44,"text":"啊，那么今天我，我们都觉得这是。","caption_chars":[["啊",449.08,449.4],["，",449.4,449.4],["那",449.8,449.88],["么",449.88,449.96],["今",449.96,450.2],["天",450.2,450.36],["我",450.36,450.6],["，",450.6,450.6],["我",451.24,451.32],["们",451.32,451.4],["都",451.4,451.56],["觉",451.56,451.96],["得",451.96,452.04],["这",452.04,452.2],["是",452.2,452.44],["。",452.44,452.44]]},
    {"start":453.72,"end":457.16,"text":"这是一个好的机会，啊，这种机会。","caption_chars":[["这",453.72,453.8],["是",453.8,453.96],["一",453.96,454.04],["个",454.04,454.2],["好",454.28,454.52],["的",454.52,454.6],["机",454.6,454.84],["会",454.84,455.0],["，",455.0,455.0],["啊",455.64,455.8],["，",455.8,455.8],["这",456.44,456.6],["种",456.6,456.76],["机",456.76,456.92],["会",456.92,457.16],["。",457.16,457.16]]},
    {"start":458.6,"end":461.0,"text":"可能也是几十年不遇，就不是可","caption_chars":[["可",458.6,458.76],["能",458.76,458.84],["也",458.84,459.0],["是",459.0,459.08],["几",459.08,459.32],["十",459.32,459.48],["年",459.48,459.64],["不",459.64,459.8],["遇",459.8,460.04],["，",460.04,460.04],["就",460.44,460.52],["不",460.52,460.68],["是",460.68,460.84],["可",460.84,461.0]]},
    {"start":462.6,"end":462.6,"text":"能。","caption_chars":[["能",462.6,462.6],["。",462.6,462.6]]},
    {"start":462.6,"end":465.96,"text":"啊，我不喜欢说一些可能，就是我预测的","caption_chars":[["啊",462.6,462.84],["，",462.84,462.84],["我",463.24,463.4],["不",463.4,463.56],["喜",463.56,463.8],["欢",463.8,463.88],["说",463.88,464.12],["一",464.12,464.12],["些",464.12,464.28],["可",464.28,464.52],["能",464.52,464.68],["，",464.68,464.68],["就",465.0,465.08],["是",465.08,465.24],["我",465.24,465.4],["预",465.4,465.56],["测",465.56,465.8],["的",465.8,465.96]]},
    {"start":465.96,"end":467.8,"text":"事，我就知道它结果。","caption_chars":[["事",465.96,466.12],["，",466.12,466.12],["我",466.6,466.68],["就",466.68,466.92],["知",466.92,467.16],["道",467.16,467.32],["它",467.32,467.4],["结",467.4,467.64],["果",467.64,467.8],["。",467.8,467.8]]},
    {"start":469.48,"end":470.84,"text":"啊，它是一定的。","caption_chars":[["啊",469.48,469.72],["，",469.72,469.72],["它",470.12,470.2],["是",470.2,470.36],["一",470.36,470.52],["定",470.52,470.84],["的",470.84,470.84],["。",470.84,470.84]]},
    {"start":472.2,"end":473.72,"text":"啊，就要达到那个结果。","caption_chars":[["啊",472.2,472.36],["，",472.36,472.36],["就",472.6,472.76],["要",472.76,472.84],["达",472.84,473.08],["到",473.08,473.16],["那",473.16,473.24],["个",473.24,473.32],["结",473.32,473.56],["果",473.56,473.72],["。",473.72,473.72]]},
    {"start":474.2,"end":475.8,"text":"现在你如果。","caption_chars":[["现",474.2,474.36],["在",474.36,474.68],["你",475.08,475.32],["如",475.32,475.4],["果",475.4,475.8],["。",475.8,475.8]]}
