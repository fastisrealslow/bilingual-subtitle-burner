{
  "evidence": "Published BV1f4W16REeu, receipt SHA256 72e1ba87bd99505d65320cab14d69dbf1825c00d29b3716f31efb54077a1786c; subtitle_edit_proof_4-1 raw_entries mapped without text edits. Public frames at 95.03 and 96.73 seconds retain the request.",
  "cues": [
    {
      "start": 0.0,
      "end": 1.1199999999998909,
      "text": "最后一个问题的机会，"
    },
    {
      "start": 2.6399999999998727,
      "end": 3.4400000000000546,
      "text": "呃，"
    },
    {
      "start": 4.559999999999945,
      "end": 6.7999999999999545,
      "text": "这位美女吧，呃，好。啊，"
    },
    {
      "start": 9.519999999999982,
      "end": 11.519999999999982,
      "text": "林总您好，我有一个非常朴素的问题，"
    },
    {
      "start": 11.519999999999982,
      "end": 15.519999999999982,
      "text": "您刚刚提到了那个新科技，那么在呃您上"
    },
    {
      "start": 15.519999999999982,
      "end": 18.720000000000027,
      "text": "位涉猎的所有的新的技术啊，新的方向和"
    },
    {
      "start": 18.720000000000027,
      "end": 21.440000000000055,
      "text": "新的赛道当中，您对什么最感兴趣？谢谢。"
    },
    {
      "start": 23.11999999999989,
      "end": 26.24000000000001,
      "text": "我是基本上都不感兴趣。"
    },
    {
      "start": 26.319999999999936,
      "end": 27.59999999999991,
      "text": "我猜到了这个答案。"
    },
    {
      "start": 27.59999999999991,
      "end": 30.319999999999936,
      "text": "啊，因为我我们投资都是有纪律的，"
    },
    {
      "start": 30.399999999999864,
      "end": 33.11999999999989,
      "text": "我不感兴趣的就不去搞，浪费时间。"
    },
    {
      "start": 33.679999999999836,
      "end": 36.48000000000002,
      "text": "人生时间是有限的，是吧？"
    },
    {
      "start": 36.63999999999987,
      "end": 39.200000000000045,
      "text": "但是我又知道那个里边一定会，"
    },
    {
      "start": 40.559999999999945,
      "end": 43.200000000000045,
      "text": "比如说新能源、新能源赛道，这都知道是"
    },
    {
      "start": 43.200000000000045,
      "end": 45.11999999999989,
      "text": "吧？还有一些人工智能，"
    },
    {
      "start": 46.399999999999864,
      "end": 47.75999999999999,
      "text": "这是明白的事。"
    },
    {
      "start": 48.48000000000002,
      "end": 53.919999999999845,
      "text": "啊，节能，啊，呃呃排，这个碳排放，"
    },
    {
      "start": 53.919999999999845,
      "end": 55.919999999999845,
      "text": "这些都肯定都是一个大的赛道。"
    },
    {
      "start": 57.51999999999998,
      "end": 58.87999999999988,
      "text": "但是为什么我不去搞？"
    },
    {
      "start": 61.440000000000055,
      "end": 64.48000000000002,
      "text": "就是我说刚才说了，其实科学家不能不见"
    },
    {
      "start": 64.48000000000002,
      "end": 67.3599999999999,
      "text": "得是企业家能挣了钱拿到一个兜里，"
    },
    {
      "start": 67.3599999999999,
      "end": 67.83999999999992,
      "text": "是不是？"
    },
    {
      "start": 68.63999999999987,
      "end": 70.48000000000002,
      "text": "他去投资，投资都是有风险。"
    },
    {
      "start": 71.3599999999999,
      "end": 75.59999999999991,
      "text": "啊，这又这又说回来，我们是做一个就是"
    },
    {
      "start": 75.59999999999991,
      "end": 78.72000000000003,
      "text": "滚雪球的事，我们不不允许失败，"
    },
    {
      "start": 79.3599999999999,
      "end": 82.31999999999994,
      "text": "我不允许我自己失败，哪怕一次失败，"
    },
    {
      "start": 82.55999999999995,
      "end": 83.27999999999997,
      "text": "我都不允许，"
    },
    {
      "start": 86.48000000000002,
      "end": 86.87999999999988,
      "text": "是吧？"
    },
    {
      "start": 87.27999999999997,
      "end": 90.15999999999985,
      "text": "那个我知道会改变人的命运，改变人的命"
    },
    {
      "start": 90.15999999999985,
      "end": 92.15999999999985,
      "text": "运一定有，但是我不同。"
    },
    {
      "start": 93.75999999999999,
      "end": 97.03999999999996,
      "text": "嗯，呃，这边朋友还是给我一个机会吧。"
    }
  ]
}
