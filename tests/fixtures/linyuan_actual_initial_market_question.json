{
  "source_sha256": "03d6609a426bebac728302a11d61384357cfb6bc9bd4694ca0ee4b4d0ca76d68",
  "duration_sec": 108.75,
  "cues": [
    {
      "start": 0.16,
      "end": 1.92,
      "text": "当下十点的券商怎么看？"
    },
    {
      "start": 2.48,
      "end": 4.08,
      "text": "券商行业这个十点是"
    },
    {
      "start": 5.6,
      "end": 8.16,
      "text": "是值得期待的，但是我们也不投，"
    },
    {
      "start": 8.4,
      "end": 11.28,
      "text": "别的都不投了。现在这是我近"
    },
    {
      "start": 12.56,
      "end": 17.52,
      "text": "大半年的我的思考，我就变从行业多行业"
    },
    {
      "start": 17.52,
      "end": 20.88,
      "text": "关注，但是我变为就是更加的集中。"
    },
    {
      "start": 21.92,
      "end": 25.2,
      "text": "这就是你要投资全呃市场多数股票，"
    },
    {
      "start": 25.28,
      "end": 28.72,
      "text": "很多东西你都要去关注，还是我把它集中"
    },
    {
      "start": 28.72,
      "end": 33.16,
      "text": "在很小的范围内，因为我们我总结了这过"
    },
    {
      "start": 33.16,
      "end": 34.92,
      "text": "去我们几十年的这个经验。"
    },
    {
      "start": 35.32,
      "end": 38.2,
      "text": "国际上能发财的，只需要一两次机会就够"
    },
    {
      "start": 38.2,
      "end": 38.44,
      "text": "了。"
    },
    {
      "start": 38.84,
      "end": 43.48,
      "text": "人生只要判断对一个，你就发大财了。"
    },
    {
      "start": 44.04,
      "end": 45.56,
      "text": "你也别说我运气啊，"
    },
    {
      "start": 47.24,
      "end": 50.52,
      "text": "还还敢几次运气，就一次运气就够了，"
    },
    {
      "start": 51.24,
      "end": 51.96,
      "text": "改变命运。"
    },
    {
      "start": 52.92,
      "end": 55.32,
      "text": "所以从这个角度上，我们只赌一个。"
    },
    {
      "start": 55.48,
      "end": 58.92,
      "text": "你说我是赌也是赌，你说我是投资也是投"
    },
    {
      "start": 58.92,
      "end": 60.28,
      "text": "资，但是"
    },
    {
      "start": 61.64,
      "end": 64.52,
      "text": "我们这个投机是经过我们"
    },
    {
      "start": 66.04,
      "end": 71.4,
      "text": "判断的，但是经过量化，最后会体现在是"
    },
    {
      "start": 71.4,
      "end": 72.12,
      "text": "正确的。"
    },
    {
      "start": 72.52,
      "end": 75.56,
      "text": "那最后变成的就是投资，我们说的价值。"
    },
    {
      "start": 75.96,
      "end": 79.0,
      "text": "也别说那么多了，就把这一亩这一点，"
    },
    {
      "start": 79.0,
      "end": 81.08,
      "text": "我再能赚上，那就是不得了了。"
    },
    {
      "start": 81.8,
      "end": 83.8,
      "text": "人生只要一次，朋友"
    },
    {
      "start": 84.84,
      "end": 85.32,
      "text": "们，对吧？"
    },
    {
      "start": 85.72,
      "end": 89.64,
      "text": "去多多去想，下次想想多了，我说你现在"
    },
    {
      "start": 89.64,
      "end": 93.16,
      "text": "把钱人民币存入银行，可能未来二十年都"
    },
    {
      "start": 93.16,
      "end": 95.96,
      "text": "是好的。形形色色，我们看了多少啊？"
    },
    {
      "start": 96.12,
      "end": 98.44,
      "text": "今天有钱的人，明天变成个穷光蛋。"
    },
    {
      "start": 99.0,
      "end": 100.52,
      "text": "投资失败是很可怕。"
    },
    {
      "start": 100.92,
      "end": 104.6,
      "text": "坚决看好第一的动能，有第一就不投第二，"
    },
    {
      "start": 104.84,
      "end": 106.36,
      "text": "不投听也不听。"
    },
    {
      "start": 106.68,
      "end": 107.48,
      "text": "这就是我的态度。"
    }
  ]
}
