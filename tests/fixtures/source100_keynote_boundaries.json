{"7":{"source_sha256":"64fa677c6235f9121dc444b0d432990e1b49e3fb69cc0d590f851a93c88dea6b","run_id":"35098194067","cues":[{"start":0.08,"end":0.48,"text":"在这，这"},{"start":1.6,"end":5.76,"text":"我相信，如果你听了，呃，应该是有有有"},{"start":6.08,"end":9.6,"text":"这个，至少我能给大家鼓劲儿，是吧？"},{"start":9.92,"end":13.2,"text":"今天这个是位置很很重要，啊，也很"},{"start":14.32,"end":15.68,"text":"适合投资的位置，"},{"start":17.04,"end":22.0,"text":"适合我们就是把把一些这个钱在这个位置"},{"start":22.0,"end":23.04,"text":"投进去啊。"},{"start":24.32,"end":26.96,"text":"那么我们说，这是我人生当中啊，"},{"start":27.2,"end":31.56,"text":"我到目前我，就半夜醒来反复想这个事儿。"},{"start":32.2,"end":33.0,"text":"我觉得这是我"},{"start":35.08,"end":37.08,"text":"人生中被遇到的"},{"start":38.2,"end":39.16,"text":"最好的机会。"},{"start":40.44,"end":43.8,"text":"那么过去有两次机会，我是抓住了啊。"},{"start":44.36,"end":47.64,"text":"那么今天这个位置就是我们要投啊，"},{"start":47.72,"end":51.16,"text":"就是改变人生命运的时，这个这个机会大，机"},{"start":52.76,"end":53.24,"text":"会。为什么呢？"},{"start":54.2,"end":57.4,"text":"只要人赚钱啊，就是抓机会，投机投机投"},{"start":57.4,"end":58.04,"text":"机。"},{"start":58.44,"end":60.76,"text":"今天这个位置是，就是"},{"start":61.8,"end":63.8,"text":"不管从哪个角度上看，"},{"start":65.8,"end":68.44,"text":"都是投投资的好机会"},{"start":69.64,"end":69.88,"text":"啊。"},{"start":70.36,"end":74.04,"text":"至于我们的感受，当然现在趋势向下，"},{"start":74.68,"end":75.0,"text":"是吧？"},{"start":75.32,"end":75.72,"text":"投"},{"start":77.16,"end":78.12,"text":"都是要亏钱的，"},{"start":79.56,"end":81.32,"text":"感受一定觉得是亏钱的。"},{"start":81.96,"end":83.24,"text":"我就说，我"},{"start":84.44,"end":84.92,"text":"今天"},{"start":86.84,"end":87.88,"text":"每一次说，"},{"start":88.92,"end":91.56,"text":"说这个月说今今天是个好机会，"},{"start":91.88,"end":93.8,"text":"下个月我可能还是个好机会。"},{"start":94.12,"end":97.32,"text":"但是大家听到我的话，还是不是钱，"},{"start":98.28,"end":99.0,"text":"还是要亏钱。"},{"start":101.0,"end":102.2,"text":"结果是一定知道。"},{"start":102.76,"end":103.8,"text":"但是我告诉，我"},{"start":104.92,"end":107.88,"text":"们身边的人，我说：我只要对一次，"},{"start":108.12,"end":108.6,"text":"就不得了。"},{"start":110.36,"end":110.68,"text":"为什么？"},{"start":111.64,"end":114.04,"text":"这就是我们的钱是从哪来的？"},{"start":114.6,"end":116.68,"text":"那么钱就是在里面等来的。"},{"start":117.0,"end":120.76,"text":"我们必须今天就投，不投在里面，它回来。"},{"start":121.72,"end":124.92,"text":"假如说我看一个是个预测，比如未来二十"},{"start":124.92,"end":128.84,"text":"年或者十年，是一个赚到一百块钱的时候，"},{"start":129.32,"end":132.52,"text":"今天这个机会，你如果能赚到第一个一块"},{"start":132.52,"end":134.28,"text":"钱，那就非常重要。"},{"start":135.24,"end":139.08,"text":"股市它是靠泡沫来，最后赚钱是靠泡沫，"},{"start":139.32,"end":140.36,"text":"投机市场都是这样。"},{"start":141.8,"end":145.24,"text":"啊，那么你赚到第一个一块钱或者两块钱"},{"start":145.24,"end":148.68,"text":"的时候，实际上最后那个百分之九十八，"},{"start":149.4,"end":152.68,"text":"那个赚的反倒是很容易了，"},{"start":153.72,"end":156.6,"text":"就那九十八块赚的很容易，这个两块钱是"},{"start":156.76,"end":158.52,"text":"非常艰难的。"},{"start":159.88,"end":163.64,"text":"这就是说，我们要抓住赚这两块钱块钱的"},{"start":164.36,"end":164.36,"text":"基础，"},{"start":166.04,"end":166.68,"text":"非常重要。"},{"start":166.76,"end":172.12,"text":"后来你从容易了的难的角度上，"},{"start":172.52,"end":174.76,"text":"那那后变得九十八块钱，"},{"start":175.96,"end":177.4,"text":"比这两块钱容易的多。"},{"start":177.8,"end":181.4,"text":"那么我就详细就讲一下，就是为什么我们"},{"start":181.4,"end":182.6,"text":"说今天这是个打击。"},{"start":183.72,"end":189.0,"text":"第一个估值很便宜，那我们上看这个上证"},{"start":189.0,"end":189.32,"text":"综指，"},{"start":190.92,"end":194.36,"text":"那P一现在十二三倍，那我们我们看这个"},{"start":194.36,"end":196.2,"text":"就是我们最坏的结果。"},{"start":198.2,"end":198.68,"text":"那就是"},{"start":199.96,"end":203.48,"text":"十二三年，你今天的投资能回本，是吧？"},{"start":203.88,"end":207.16,"text":"国际上这个平均的回本期的话，"},{"start":207.72,"end":210.36,"text":"都在二十五倍以上，就是我们说二十五年"},{"start":210.36,"end":210.76,"text":"以上。"},{"start":212.44,"end":215.16,"text":"啊，那么我们今天投资最坏的结果就是"},{"start":216.52,"end":217.72,"text":"十二到十三年回。"},{"start":219.08,"end":221.96,"text":"啊，这个是基于十二三年以后，"},{"start":223.64,"end":228.12,"text":"我们的生活水平就是人人均收入啊，"},{"start":229.0,"end":230.52,"text":"比今天不减少。"},{"start":232.92,"end":236.76,"text":"啊，并没有去期望十二三年那个比今天多。"},{"start":237.64,"end":242.12,"text":"如果跟今天的平持平的话，那么我们就是"},{"start":242.6,"end":245.32,"text":"十二三年是个平均水平的话，就是回本，"},{"start":245.64,"end":246.68,"text":"回本期十二三年。"},{"start":247.64,"end":251.72,"text":"再一个，这是第一个，就是整个就是"},{"start":253.32,"end":256.36,"text":"市场不高啊，估值很便宜"},{"start":257.64,"end":257.8,"text":"啊。"},{"start":258.36,"end":261.32,"text":"那么十二三倍，我发现是一个，"},{"start":263.0,"end":266.52,"text":"就中国股市A股市场啊，每一次到这个位"},{"start":266.52,"end":268.52,"text":"置，政府就要出"},{"start":269.8,"end":271.64,"text":"出一些政策啊。"},{"start":272.2,"end":276.2,"text":"这个位置所有的股民感觉的都是亏钱。"},{"start":278.28,"end":280.92,"text":"过去也发生过，就是我说的两次，"},{"start":281.24,"end":284.84,"text":"一次是大概是九六年，一次是二零零三年"},{"start":284.84,"end":285.88,"text":"到零六年之间。"},{"start":287.32,"end":290.76,"text":"啊，都是，呃，PE大概都是十二三倍。"},{"start":291.56,"end":295.0,"text":"啊，市场的反应跟今天一样，都是亏。"},{"start":297.0,"end":297.08,"text":"啊，"},{"start":298.36,"end":299.56,"text":"哪个人都觉得难，"},{"start":301.08,"end":301.64,"text":"不容易。"},{"start":304.84,"end":308.52,"text":"都是觉得你有钱放在那里，什么不投资是"},{"start":308.76,"end":309.4,"text":"好的结果。"},{"start":312.36,"end":314.2,"text":"这是全世界都是不正常。"},{"start":317.32,"end":320.68,"text":"你找这原因那原因，其实都不是原因，"},{"start":321.64,"end":324.04,"text":"就是今天这个位置就是不挣钱，"},{"start":324.84,"end":328.2,"text":"但是值得投资的，就是我们说，"},{"start":330.76,"end":334.12,"text":"从政策面或者从估值的角度上都是便宜。"},{"start":335.56,"end":339.48,"text":"那么我们又找到了一个今天投资的一个得"},{"start":339.48,"end":342.84,"text":"兜底的东西，我们找到了一个养老行业。"},{"start":344.04,"end":345.96,"text":"啊，老老人口老龄化。"},{"start":346.6,"end":349.56,"text":"我们说六六七十年代出生人口啊，"},{"start":350.2,"end":354.12,"text":"在全球范围内都是一个高人口高高出生率"},{"start":354.12,"end":355.64,"text":"的一个年代。"},{"start":355.96,"end":357.8,"text":"那八十年代就计划生育了，"},{"start":359.08,"end":359.56,"text":"是吧？"},{"start":359.8,"end":363.88,"text":"这些人的年龄今天都在都在五十岁以上"},{"start":365.48,"end":365.72,"text":"啊。"},{"start":366.84,"end":367.08,"text":"那么"},{"start":368.2,"end":371.72,"text":"我们统计的话，六十年六十岁以上的人口"},{"start":371.8,"end":373.64,"text":"现在大概有两亿六。"},{"start":377.72,"end":381.08,"text":"到二零五七年的话，这个人口数量增加到"},{"start":381.08,"end":381.8,"text":"十四亿九。"},{"start":383.56,"end":386.36,"text":"啊，我们就做这这未来三十年，"},{"start":386.92,"end":389.16,"text":"这四亿九，这这个生意就不得了。"},{"start":389.96,"end":391.16,"text":"我们看美国的这个"},{"start":393.24,"end":396.44,"text":"人口，这个现在大概六十岁以上是四千万。"},{"start":397.48,"end":398.84,"text":"我们中国现在是两亿六。"},{"start":399.96,"end":402.52,"text":"再看欧美这个这个股市的医药股啊，"},{"start":404.04,"end":408.36,"text":"我们上市的这个医药股的总市值大概只有"},{"start":408.36,"end":411.4,"text":"欧美股市一个多一点，第一名的一个多一"},{"start":411.4,"end":414.52,"text":"点点市值，利润也是相当"},{"start":415.8,"end":416.68,"text":"差的远着呢。"},{"start":418.12,"end":421.16,"text":"那么我们相信三十年以后，如果按这样的"},{"start":421.32,"end":424.84,"text":"速度，这样的消费能力去计算的话，"},{"start":425.48,"end":428.36,"text":"二十年以后，中国的这个医药，"},{"start":428.52,"end":432.76,"text":"特别是与老龄化有关系有关的这个医药工"},{"start":432.76,"end":432.92,"text":"业，"},{"start":433.96,"end":439.56,"text":"这个利润或者市值，都应该是全球十大医"},{"start":439.56,"end":441.56,"text":"药公司，我觉得中国最少有五家。"},{"start":443.08,"end":448.04,"text":"因为就是现在才是我们这个老龄化的零年，"},{"start":448.92,"end":452.12,"text":"你如果相比二二十年以后，今天的消费是"},{"start":452.12,"end":453.32,"text":"个零，这些"},{"start":454.68,"end":457.56,"text":"药品啊，都要在五六十岁才开始用。"},{"start":458.6,"end":461.72,"text":"啊，我个人有一个，我有糖尿病，"},{"start":461.72,"end":462.76,"text":"有高血压，大概我"},{"start":464.6,"end":467.32,"text":"我五十七岁的时候，我的这方面的开支是"},{"start":467.48,"end":470.76,"text":"零，但今天我每个月的开支是两千五。"},{"start":472.28,"end":475.08,"text":"我大概是二零零一年得的糖尿病，"},{"start":476.04,"end":477.08,"text":"然后我打胰岛素。"},{"start":478.84,"end":481.72,"text":"最早打胰岛素的话，一个月的用量大概是"},{"start":482.44,"end":483.88,"text":"两百四十块钱。"},{"start":485.48,"end":489.64,"text":"到今天，我糖尿病这个药，呃这个呃，"},{"start":490.2,"end":494.28,"text":"胰岛素加上高血压那些控制高血压疾病的"},{"start":494.28,"end":496.84,"text":"这这种药物，我大概花了四百块。"},{"start":496.92,"end":502.28,"text":"但是我关于老龄化这个这个上面的用药啊，"},{"start":502.6,"end":505.88,"text":"我现在已经达到了两千五百，不包括这四"},{"start":505.88,"end":505.96,"text":"百。"},{"start":507.48,"end":509.96,"text":"就我们到这个年龄呢，这些这些疾病，"},{"start":509.96,"end":511.64,"text":"它就是要，就是"},{"start":512.76,"end":513.56,"text":"要要发生。"},{"start":515.32,"end":517.56,"text":"啊，过去可能这个人怎么死了，"},{"start":517.56,"end":518.28,"text":"他也不知道。"},{"start":518.28,"end":521.88,"text":"现在这个都是他有反应了，有这些并发症。"},{"start":522.52,"end":525.0,"text":"你不吃这药，他就不舒服。"},{"start":525.16,"end":527.96,"text":"所以我今天出来带的秘书中午吃饭，"},{"start":527.96,"end":529.8,"text":"他说：你吃这个老板，我给你泡一杯。"},{"start":529.88,"end":531.64,"text":"我说：泡了我吃。"},{"start":532.68,"end":536.2,"text":"那吃了和不吃，你一段时间不吃就不舒服"},{"start":536.2,"end":536.28,"text":"的。"},{"start":537.88,"end":541.56,"text":"啊，那这个很重要，就相对于"},{"start":542.84,"end":544.84,"text":"几十年以后今天的是市民的。"},{"start":547.96,"end":551.4,"text":"那么我我们就投这个赛道，这个赛道又给"},{"start":551.4,"end":552.92,"text":"我们保证了未来三十年"},{"start":554.36,"end":557.0,"text":"是一个从零变得无限大的一个行业。"},{"start":558.28,"end":562.04,"text":"那么抓行业又是非常重要的，就是在一个"},{"start":562.2,"end":566.52,"text":"低位的时候，再一个就是合合理偏低的位"},{"start":566.52,"end":570.36,"text":"置的大环境下，我们投资行业是很重要。"},{"start":571.8,"end":575.08,"text":"我再讲一下为什么我说重要、重要、重要。"},{"start":578.68,"end":579.96,"text":"那么九六年的时候，"},{"start":581.16,"end":585.08,"text":"啊，当指数去这个上证指数去到五百九十"},{"start":585.08,"end":589.48,"text":"多点的时候，那个时候政府也是出了政策，"},{"start":589.88,"end":592.6,"text":"也是停止新股发行，降低印花税了，"},{"start":593.24,"end":593.64,"text":"有这个。"},{"start":594.52,"end":597.32,"text":"结果股指还最后走到四百不到，"},{"start":598.28,"end":599.16,"text":"不到四百点最"},{"start":600.2,"end":601.56,"text":"低，也跌了接近两百点。"},{"start":602.44,"end":604.28,"text":"啊，那个时候"},{"start":606.44,"end":608.68,"text":"市场情况跟今天一样，都是亏损。"},{"start":611.96,"end":614.44,"text":"因为我在这个市场时间长了，我觉得全球"},{"start":614.44,"end":615.64,"text":"的规律都是一样。"},{"start":617.72,"end":619.72,"text":"你怎么采取措施，它都要跌。"},{"start":621.64,"end":625.8,"text":"啊，那么那时候我们抓住了一个行业，"},{"start":626.52,"end":630.28,"text":"就是家电的普及，电特别是电视机的及。"},{"start":631.0,"end":633.72,"text":"那个时候人就是有钱了。"},{"start":633.72,"end":636.2,"text":"那张老师知道我去香港还备一个电视机回"},{"start":636.2,"end":637.08,"text":"来，是不是啊？"},{"start":637.56,"end":640.36,"text":"我记得我们还买了个录像机，半夜还看录"},{"start":640.44,"end":641.8,"text":"像机，他是我们的邻居。"},{"start":642.84,"end":645.88,"text":"那时候年轻人啊，都买个录像机音响电视。"},{"start":646.28,"end":648.04,"text":"我们那时候就抓住了这个行业。"},{"start":649.4,"end":654.44,"text":"啊，所以电视机厂家当时都是些大市值的，"},{"start":654.6,"end":655.8,"text":"催生了电视机。"},{"start":655.8,"end":658.36,"text":"比如说长虹，那时候是龙头，康佳什么，"},{"start":659.48,"end":661.48,"text":"就是创维都是那个什么牌子的，"},{"start":661.88,"end":663.72,"text":"巨无霸啊。"},{"start":664.44,"end":667.24,"text":"所以我们当时抓住了这个行业，"},{"start":667.24,"end":669.0,"text":"我们猛赚了一笔。"},{"start":669.32,"end":672.04,"text":"我今天做的机会都不低于一百倍"},{"start":674.44,"end":674.68,"text":"啊。"},{"start":675.0,"end":679.64,"text":"那么到指数后来也从了四百点涨到了二零"},{"start":679.64,"end":681.4,"text":"零二年的两千二百点。"},{"start":683.16,"end":685.48,"text":"那么到了二零零二年以后又低迷，"},{"start":686.28,"end":689.72,"text":"到了零五年的时候，指数又去到了一千三"},{"start":689.72,"end":691.96,"text":"百多点。"},{"start":692.28,"end":696.28,"text":"那么政府那个时候的PE又是一个十二倍、"},{"start":696.28,"end":696.92,"text":"十三倍。"},{"start":697.16,"end":700.44,"text":"我都是，因为我印象，发生这故事的时候，"},{"start":700.44,"end":701.8,"text":"我都有印象。"},{"start":703.96,"end":707.64,"text":"而且这个市场上的这些，这个这个反应啊，"},{"start":707.64,"end":710.28,"text":"也都差不多，股市都是亏钱的啊，"},{"start":712.12,"end":712.92,"text":"都是亏钱。"},{"start":713.32,"end":715.64,"text":"这个时候我们觉得机会来了，我们又投，"},{"start":716.2,"end":716.76,"text":"就开始投。"},{"start":716.92,"end":720.28,"text":"从零三年，当然这个时候那个那个点位对"},{"start":720.28,"end":722.76,"text":"我们影响，也是抓住了一个大的这个"},{"start":724.84,"end":725.48,"text":"行业。"},{"start":726.2,"end":729.4,"text":"那个时候整天就说中国人到这个程度了，"},{"start":729.4,"end":730.44,"text":"应该销售一个"},{"start":732.2,"end":733.16,"text":"消费升级。"},{"start":734.28,"end":737.32,"text":"啊，我们对这个消费升级，我们是有有体"},{"start":737.4,"end":740.04,"text":"会的，因为我是一个外国人，我们投资了，"},{"start":740.04,"end":741.56,"text":"就比如说境外我们也投资。"},{"start":742.2,"end":745.64,"text":"那么我们投资是九四年开始投资的，"},{"start":746.36,"end":749.08,"text":"我们都是一些投资一些品牌的东西，"},{"start":749.8,"end":751.48,"text":"就你能叫上品牌，我都投。"},{"start":753.24,"end":757.0,"text":"我们到二零零三年呢以后，零四年我那时"},{"start":757.0,"end":759.96,"text":"候已经产生很大的收益了，所以我对这个"},{"start":759.96,"end":763.08,"text":"品牌就特别敏感。谁让我们是投资品牌的，"},{"start":764.84,"end":768.12,"text":"品牌的企业，就消费升级升级了什么呢？"},{"start":768.36,"end":770.36,"text":"都是投资品牌的啊。"},{"start":770.44,"end":773.56,"text":"然后我们就是以嘴巴为主去投资一些品牌。"},{"start":773.72,"end":776.36,"text":"那么大家说我运气好，我们最后选了个茅"},{"start":776.52,"end":776.6,"text":"台。"},{"start":777.24,"end":779.08,"text":"实际上我们开始不是选择茅台，"},{"start":779.08,"end":783.08,"text":"我们是投资把这个和最有关系的消费品都"},{"start":783.08,"end":783.72,"text":"投了一遍。"},{"start":785.0,"end":788.68,"text":"啊，我们就锁定在这个品牌消费里边，"},{"start":789.0,"end":791.24,"text":"我们去找龙头。"},{"start":791.4,"end":794.84,"text":"我们通过几年的比较，零三年到零零六年，"},{"start":794.84,"end":799.8,"text":"我们比较比较比较，后来从财务指标上选"},{"start":799.8,"end":801.48,"text":"择了茅台，它最好。"},{"start":804.84,"end":808.04,"text":"也是通过几年这么比较，后来才集中这茅"},{"start":809.56,"end":809.56,"text":"台。"},{"start":809.64,"end":812.44,"text":"大家今天一听，是不是就是好像我就是腾"},{"start":812.44,"end":814.52,"text":"空出世，就选这个不是的。"},{"start":815.16,"end":819.32,"text":"他一定是在一个大的背景下，你再去。"},{"start":821.16,"end":823.8,"text":"通过这个财务数据、财务跟踪，"},{"start":824.68,"end":825.96,"text":"最后是数据说话。"},{"start":826.12,"end":829.0,"text":"他的财务指标就是最好，他赚钱能力就是"},{"start":829.0,"end":829.24,"text":"最强。"},{"start":830.52,"end":831.24,"text":"才选定的。"},{"start":832.92,"end":834.68,"text":"那就毫无疑问往那上面集中。"},{"start":836.84,"end":837.8,"text":"这个是很容易的。"},{"start":839.8,"end":842.36,"text":"那个时候并不知道，他也是"},{"start":843.4,"end":845.72,"text":"有很多行业都是在竞争，"},{"start":847.0,"end":848.04,"text":"非常激烈的情况下。"},{"start":848.84,"end":850.52,"text":"这就是我们说的行业。"},{"start":851.32,"end":855.16,"text":"我我们要什么时候投这个，就是行业进入"},{"start":855.16,"end":855.72,"text":"这个"},{"start":857.8,"end":859.08,"text":"高速发展的时候。"},{"start":859.56,"end":862.44,"text":"那个时候就是为什么投品牌的品，"},{"start":862.76,"end":865.64,"text":"中国人的收入到那个程度，他就要消费品"},{"start":865.72,"end":866.76,"text":"牌的东西。"},{"start":868.68,"end":870.84,"text":"比如说以前白酒是吧？"},{"start":871.0,"end":873.96,"text":"大家在这个菜市场打一个，那还出现了，"},{"start":874.52,"end":877.72,"text":"呃，毒死人的事情，还出现这个食品安全"},{"start":877.72,"end":878.04,"text":"问题。"},{"start":878.92,"end":882.2,"text":"后来大家就认品牌，认品牌，都买往品牌"},{"start":882.2,"end":882.68,"text":"上寄托。"},{"start":883.08,"end":886.04,"text":"所以那个时候我们思路是投资品牌的东西，"},{"start":887.08,"end":889.56,"text":"并没有说是哪一个企业你不好说。"},{"start":890.04,"end":892.2,"text":"那么今天我们说投资这个医药，"},{"start":892.36,"end":895.56,"text":"我们投资这个养老的医药，我们也是在这"},{"start":895.56,"end":897.0,"text":"个大的行业里面。"},{"start":898.84,"end":901.88,"text":"通过财务指标，我们对这个企业的认识，"},{"start":902.6,"end":903.96,"text":"然后集中到龙头。"},{"start":905.4,"end":907.32,"text":"我今天可以肯定的告诉大家，"},{"start":908.36,"end":911.4,"text":"就我们选择今天选择这个养老的赛道，"},{"start":911.72,"end":915.0,"text":"绝对不会低于一万倍的起，要涨一万倍，"},{"start":916.6,"end":917.0,"text":"一定的。"},{"start":919.48,"end":920.76,"text":"一万倍我都少说了，"},{"start":923.4,"end":924.04,"text":"就今天投。"},{"start":925.56,"end":928.12,"text":"所以这个行业宏观也进入这个时候了，"},{"start":928.68,"end":929.8,"text":"你投不会错的。"},{"start":930.84,"end":934.68,"text":"那么我们只需要对，就像一个黑屋子里面，"},{"start":934.68,"end":936.84,"text":"我就关到这个这个这个里边了，"},{"start":937.32,"end":940.28,"text":"我就在这个里边，去找。"},{"start":940.76,"end":944.28,"text":"通过时间，因为这个，它不是说这个龙头"},{"start":944.28,"end":948.12,"text":"你今天就产生了，它是这个行业大了以后，"},{"start":949.16,"end":950.44,"text":"慢慢慢慢慢慢，"},{"start":951.64,"end":953.48,"text":"往龙头企业去去集中。"},{"start":954.6,"end":957.64,"text":"我们通过财务指标又去选择，它的经营情"},{"start":957.64,"end":959.8,"text":"况又选择这个这个"},{"start":961.08,"end":964.68,"text":"这个龙头，啊，这个巨无霸怎么产生的？"},{"start":965.08,"end":968.68,"text":"就像我举个例子吧，早期比如深圳这个地"},{"start":968.68,"end":973.08,"text":"产业啊，有万科、金田，其实好多地产公"},{"start":973.16,"end":974.04,"text":"司早期都有，"},{"start":975.88,"end":976.28,"text":"是吧？"},{"start":976.36,"end":979.32,"text":"最后发展起来的，你看金田都不在了，"},{"start":979.32,"end":982.04,"text":"还有好多，深宝安啊这些都。"},{"start":982.52,"end":985.32,"text":"那时候深宝安比比万科还厉"},{"start":987.96,"end":991.0,"text":"害，但是一步一步根据这个个行业的发展，"},{"start":991.08,"end":993.48,"text":"他们的经营情况，他们的产品，"},{"start":994.52,"end":995.72,"text":"去选出来的这个农。"},{"start":997.08,"end":1000.92,"text":"所以今天，我们我相信我这个农户一定能"},{"start":1000.92,"end":1001.32,"text":"抓住。"},{"start":1002.92,"end":1005.72,"text":"因为凡凡是这种大是大非的问题上，"},{"start":1006.2,"end":1007.64,"text":"没有一次我抓不住。"},{"start":1011.08,"end":1015.8,"text":"所以行业宏观就告诉你，现在该投这个了。"},{"start":1017.32,"end":1018.52,"text":"那么我们再看，"},{"start":1019.88,"end":1022.68,"text":"为什么我今天说这个养老医药是我们投资"},{"start":1022.68,"end":1023.56,"text":"的重中之重。"},{"start":1024.2,"end":1027.4,"text":"那么过去三年，这个医药经经历了，"},{"start":1029.24,"end":1032.28,"text":"基本上是一个危机吧，我们可以说的危机，"},{"start":1032.84,"end":1036.68,"text":"是吧？你不管它啥都有影响，舆论啊，"},{"start":1036.68,"end":1038.6,"text":"或者实质性的影响都有。"},{"start":1040.2,"end":1043.08,"text":"啊，但是我们投的我们投的行业，"},{"start":1043.24,"end":1046.76,"text":"我们看了过去三年，他们的净利润"},{"start":1047.88,"end":1051.56,"text":"或者这个这个销售收入，在这个养老上面"},{"start":1051.56,"end":1054.12,"text":"的销售，他们都是增长啊，"},{"start":1055.4,"end":1056.12,"text":"百分之一百，"},{"start":1057.32,"end":1058.52,"text":"平均水平增长百分。"},{"start":1059.56,"end":1062.36,"text":"大家可以去看一下相关的医药公司了，"},{"start":1062.36,"end":1062.52,"text":"现在。"},{"start":1064.68,"end":1065.72,"text":"那为什么它会增长？"},{"start":1066.6,"end":1069.56,"text":"啊，大家都说是工业都是在下降的，"},{"start":1069.56,"end":1070.36,"text":"它怎么会增长？"},{"start":1070.76,"end":1074.68,"text":"那就是需求它是以百分之三十的这个这个"},{"start":1074.76,"end":1075.48,"text":"需求在增长。"},{"start":1077.4,"end":1081.08,"text":"这个没有办法，需求太大了，就这种增长"},{"start":1081.08,"end":1083.72,"text":"速度。就人活的时间越长，"},{"start":1084.84,"end":1086.2,"text":"年龄越大，的消费的越多。"},{"start":1087.56,"end":1090.6,"text":"我今年花两千五百，我相信明年、"},{"start":1090.68,"end":1092.76,"text":"后年不，这个数量还会增加。"},{"start":1095.8,"end":1096.2,"text":"因为"},{"start":1097.4,"end":1100.2,"text":"我这些病啊，他一些病发症慢慢的出来，"},{"start":1101.56,"end":1103.88,"text":"你不预预防，他就要出问题。"},{"start":1104.52,"end":1107.72,"text":"所以这个就是我们投资的这个行业，"},{"start":1108.04,"end":1110.68,"text":"也是经过了一个大的地震，大的危机。"},{"start":1111.08,"end":1115.96,"text":"这个出现危机的行业或者个别公司，"},{"start":1116.84,"end":1121.88,"text":"实际上如果它未来的这个市场是非常大的，"},{"start":1122.36,"end":1122.84,"text":"是吧？"},{"start":1123.48,"end":1126.28,"text":"那么我们是可以投的，每次投都是对的。"},{"start":1126.84,"end":1130.6,"text":"我举个例子，就是我们近几年近十年吧，"},{"start":1130.6,"end":1132.92,"text":"遇到那些这个投资机会。"},{"start":1134.36,"end":1138.68,"text":"你看，大概在一零年以后，牛奶的三聚氰"},{"start":1138.68,"end":1142.76,"text":"胺，是吧？那个时候你投牛奶股不会错。"},{"start":1144.6,"end":1149.16,"text":"后来又一一一二年，一一几年又出了个塑"},{"start":1149.4,"end":1151.8,"text":"化剂，你投白酒绝绝对不会错。"},{"start":1153.64,"end":1157.32,"text":"前一段时间前几年又出了一个那个叫什么，"},{"start":1158.2,"end":1161.64,"text":"呃，常呃这个长春一个疫苗事件，"},{"start":1162.12,"end":1164.52,"text":"那个时候你投疫苗这个行业也不会错，"},{"start":1165.8,"end":1168.12,"text":"绝不会错，都是自己的。"},{"start":1169.32,"end":1170.76,"text":"就是我们送危机。"},{"start":1171.4,"end":1174.76,"text":"在国外，我我这些我今天说的都是我亲身"},{"start":1174.76,"end":1176.52,"text":"参与我投过的，是吧？"},{"start":1176.76,"end":1179.08,"text":"国外零八年我们看到美国金融危机，"},{"start":1179.08,"end":1182.36,"text":"我们就买了一揽子金融股，闭着眼睛买。"},{"start":1183.0,"end":1185.4,"text":"虽然当时我亏了很多钱，但是"},{"start":1186.76,"end":1188.76,"text":"过了那一阵子，我赚了很多钱。"},{"start":1190.44,"end":1194.6,"text":"就是买危机永远不会错，金融危机我买金"},{"start":1194.6,"end":1195.48,"text":"融股也不会错。"},{"start":1198.28,"end":1201.0,"text":"那么今天这个医药股实际上也是，"},{"start":1201.4,"end":1203.56,"text":"就是我说老龄化这一块，我"},{"start":1204.92,"end":1205.08,"text":"就"},{"start":1206.68,"end":1210.44,"text":"退一步讲，就是你整投整个投医药工业，"},{"start":1210.68,"end":1212.68,"text":"我认为都不会错。现在也是低位，"},{"start":1215.88,"end":1217.88,"text":"因为过去发生的危机，"},{"start":1220.44,"end":1223.8,"text":"这个位置已经非常非常便宜"},{"start":1227.72,"end":1229.96,"text":"了。那么今天就是入市的好机会。"},{"start":1230.28,"end":1234.2,"text":"从行业宏观上，从这个这个未来的需求，"},{"start":1234.92,"end":1235.4,"text":"是吧？"},{"start":1235.96,"end":1237.88,"text":"从这个买危机的角度，"},{"start":1239.48,"end":1240.44,"text":"都是没有问题。"},{"start":1242.36,"end":1245.32,"text":"那么这一次我们从大大盘的这个这个"},{"start":1246.36,"end":1248.52,"text":"这个角度来看的话，"},{"start":1250.68,"end":1254.36,"text":"PE都是十二和前两次，比如说九几年那"},{"start":1254.36,"end":1256.92,"text":"次，那一次和零几年那一次，它有共同的"},{"start":1256.92,"end":1258.76,"text":"特征，都是PE都是十几倍。"},{"start":1259.16,"end":1262.36,"text":"但是企业的经营情况是不一样的。"},{"start":1264.12,"end":1268.2,"text":"那两次我们过后看，是商品生产没有这么"},{"start":1268.2,"end":1268.52,"text":"多。"},{"start":1269.72,"end":1270.44,"text":"今天是，"},{"start":1271.72,"end":1274.92,"text":"对大多数企业，商品生产过剩，"},{"start":1275.72,"end":1276.52,"text":"过剩经济。"},{"start":1277.8,"end":1283.96,"text":"那么企业的竞争可想而知，效益也不会好。"},{"start":1284.52,"end":1285.64,"text":"所以这个需要淘汰。"},{"start":1287.32,"end":1290.2,"text":"就是你生产东西的，这企业要淘汰，"},{"start":1290.28,"end":1292.68,"text":"淘汰了以后，达到一个新的平衡，"},{"start":1292.68,"end":1293.8,"text":"这个是需要时间的。"},{"start":1294.2,"end":1295.72,"text":"那么企业的效益又会重新。"},{"start":1298.04,"end":1301.72,"text":"那么过去，这个投资几万亿、几万亿这么"},{"start":1301.8,"end":1302.68,"text":"投，是吧？"},{"start":1302.68,"end":1305.8,"text":"几十万亿，都修桥、修桥、修路、"},{"start":1306.04,"end":1306.84,"text":"修房子去了。"},{"start":1307.64,"end":1310.2,"text":"那么现在这些修的差不多了，怎么办呢？"},{"start":1311.08,"end":1312.92,"text":"那只能把股市搞活搞，"},{"start":1314.52,"end":1318.12,"text":"是吧？建立金融强国，炒股让这人都发，"},{"start":1318.84,"end":1320.6,"text":"都都能挣到钱，有增增钱效应。"},{"start":1322.36,"end":1323.8,"text":"是，这也是我们"},{"start":1325.4,"end":1327.8,"text":"对今天这个有信心的。"},{"start":1328.2,"end":1331.16,"text":"你如果说是今天大家都这么赚钱，"},{"start":1331.16,"end":1334.6,"text":"或者是这个企业盈利特别好，我反倒还没"},{"start":1334.92,"end":1336.36,"text":"没这么雄心雄心壮志。"},{"start":1336.84,"end":1339.72,"text":"但是整个中国人的收入，我们做了一个捋"},{"start":1339.72,"end":1341.8,"text":"了一遍啊，都平均水平。"},{"start":1342.36,"end":1344.2,"text":"中国人的收入现在还是高位。"},{"start":1344.28,"end":1347.88,"text":"中国收入，对老百姓来说，最多还是个工"},{"start":1347.88,"end":1349.4,"text":"资收入，是吧？"},{"start":1350.6,"end":1353.72,"text":"还有就是他们的，来源于各个方面家庭的"},{"start":1353.72,"end":1354.52,"text":"收入啊。"},{"start":1355.16,"end":1355.96,"text":"现在并没有减"},{"start":1357.16,"end":1361.88,"text":"少，减少是几个，但企业主的收入可能不，"},{"start":1363.0,"end":1363.64,"text":"是在减少。"},{"start":1365.16,"end":1366.92,"text":"那是因为企业经营的问题，"},{"start":1368.04,"end":1371.0,"text":"就是竞争太厉害，就是我说的过剩经济。"},{"start":1371.56,"end":1374.04,"text":"所以这个是需要淘淘汰淘汰。"},{"start":1375.0,"end":1378.28,"text":"啊，但是从养老这个、医药这个上面，"},{"start":1378.6,"end":1382.2,"text":"他们并没有过剩，因为现在这个这一块还"},{"start":1382.2,"end":1385.4,"text":"是在激烈竞争情况，行业宏观就是最好的"},{"start":1385.4,"end":1385.72,"text":"时机。"},{"start":1386.04,"end":1387.96,"text":"赶紧进，不是说风险。"},{"start":1388.52,"end":1392.28,"text":"今天我来就是，现在赶紧进去，"},{"start":1392.84,"end":1396.28,"text":"赚到了百分之二的，后面百分之八、"},{"start":1396.52,"end":1398.28,"text":"百分之九十八是改变命运。"},{"start":1398.84,"end":1404.12,"text":"就来了，听话，千万不要你你你你不听我"},{"start":1404.12,"end":1404.84,"text":"的话，那"},{"start":1407.64,"end":1410.68,"text":"啊，凡是不听我的话的，今天就白听。"},{"start":1411.56,"end":1412.04,"text":"最后，"},{"start":1413.4,"end":1415.56,"text":"多少年以后，我就告诉你：，我今天，"},{"start":1416.68,"end":1420.12,"text":"你明天去验证，后天去验证，错误的概率"},{"start":1420.12,"end":1421.08,"text":"是百分之九十八。"},{"start":1422.36,"end":1424.04,"text":"但是我只需要一次对了。"},{"start":1425.48,"end":1428.52,"text":"啊，因为股市它是你要在里面待着才有人"},{"start":1428.52,"end":1429.32,"text":"行的，能赚钱。"},{"start":1429.72,"end":1432.28,"text":"就作为我们是这个资产管理的，"},{"start":1432.84,"end":1435.0,"text":"我待在里面，你走了，"},{"start":1436.04,"end":1436.76,"text":"我一点办法。"},{"start":1437.32,"end":1440.04,"text":"只要你能在里面待着，结果就是好的。"},{"start":1440.36,"end":1442.92,"text":"所以我们的就是怎么针对这个问题，"},{"start":1443.24,"end":1446.12,"text":"就是一定要让你在里面待着待着。"},{"start":1448.12,"end":1450.44,"text":"这个对我来说就是个非常难做的事。"},{"start":1451.16,"end":1453.64,"text":"他又不挣钱，他待不住就吧，好吧，"},{"start":1453.72,"end":1454.52,"text":"我就说这么多。"},{"start":1455.64,"end":1460.6,"text":"大胆投入，然后你这个怎么控制风险？"},{"start":1460.84,"end":1462.28,"text":"你投一百万就是一百万。"},{"start":1462.28,"end":1465.88,"text":"我今天这个点投，我投了我就就就就就这"},{"start":1465.88,"end":1468.52,"text":"个，不管他了，回去睡觉。"},{"start":1469.32,"end":1470.84,"text":"你要说高低，我不知道。"},{"start":1471.24,"end":1474.2,"text":"我说明天的高低，我不知道。但是你说，"},{"start":1476.52,"end":1478.52,"text":"他不知道，我又感觉我知道。"},{"start":1480.76,"end":1481.24,"text":"是吧？"},{"start":1481.56,"end":1482.92,"text":"今天我为什么做？"},{"start":1483.0,"end":1485.72,"text":"我不说风险，说风险是，我知道打自己的"},{"start":1485.72,"end":1486.04,"text":"耳光。"},{"start":1487.72,"end":1488.68,"text":"今天不说风险。"},{"start":1489.88,"end":1491.64,"text":"我今天光说风险了，你不投。"},{"start":1494.12,"end":1494.68,"text":"是吧？"},{"start":1495.16,"end":1499.08,"text":"今天就是有那种激情，就是一个人什么时"},{"start":1499.16,"end":1500.04,"text":"候说什么的话，"},{"start":1501.08,"end":1502.28,"text":"那要有一点精神，"},{"start":1503.4,"end":1504.44,"text":"激情就要动起来。"},{"start":1505.08,"end":1508.44,"text":"投资也有时候也是要靠激情，你不知道吓"},{"start":1508.52,"end":1510.84,"text":"死吓死的人吓死了，还投资啊，"},{"start":1511.88,"end":1512.36,"text":"是吧？"},{"start":1512.44,"end":1516.04,"text":"光看那些负面的东西，这个时候是要正正"},{"start":1516.2,"end":1516.44,"text":"能量。"},{"start":1516.84,"end":1519.64,"text":"我们两个月以前，我们也发了一个公告，"},{"start":1519.8,"end":1522.92,"text":"我们跟投百分之二十，永不赎回。"},{"start":1524.12,"end":1524.92,"text":"我为什么敢这"},{"start":1526.36,"end":1526.36,"text":"么做？"},{"start":1527.56,"end":1528.04,"text":"是吧？"},{"start":1528.52,"end":1529.72,"text":"那肯定有我的道理。"},{"start":1530.36,"end":1533.56,"text":"你说我高利不知道，我有感觉我知道。"},{"start":1533.8,"end":1535.8,"text":"我今天这个位置亏了，绝不活该。"},{"start":1536.44,"end":1537.8,"text":"我活该我自己也活该。"},{"start":1539.32,"end":1539.88,"text":"是吧？"},{"start":1542.36,"end":1546.12,"text":"他投资也是有感觉的，感觉的背后是因为"},{"start":1546.12,"end":1547.56,"text":"有数字说话。"},{"start":1548.44,"end":1550.84,"text":"我能算到的数字，我是算的账。"},{"start":1553.0,"end":1554.12,"text":"今天这个位置没有问题，"},{"start":1556.92,"end":1559.4,"text":"时间也不会太长。"},{"start":1559.96,"end":1563.16,"text":"但是你要说，具体什么时候这个趋势会改"},{"start":1563.24,"end":1563.4,"text":"变呢？"},{"start":1563.72,"end":1565.88,"text":"我也说不清楚，完全不清楚。"},{"start":1566.12,"end":1567.56,"text":"我告诉你，我相信时间不会。"},{"start":1567.8,"end":1570.28,"text":"提一个问题，就是我们现在的经济面临的"},{"start":1570.28,"end":1573.08,"text":"就是，房地产现在肯定是很低落吧，"},{"start":1573.8,"end":1576.84,"text":"然后外贸出口也很低落，消费现在也很低"},{"start":1576.84,"end":1577.0,"text":"落。"},{"start":1577.4,"end":1580.28,"text":"那么基于这三种情况，它会不会对你投资"},{"start":1580.28,"end":1582.28,"text":"的养老产业是否会有影响？"},{"start":1583.16,"end":1583.56,"text":"谢谢。"},{"start":1587.56,"end":1591.0,"text":"呃，对这个养老产业的估值是有影响，"},{"start":1591.96,"end":1595.8,"text":"但是你对他这个产业的需求是没有影响。"},{"start":1596.52,"end":1597.8,"text":"我做的他都是抗拒"},{"start":1599.08,"end":1599.48,"text":"估值。"},{"start":1599.8,"end":1599.96,"text":"所以，"},{"start":1601.0,"end":1603.96,"text":"自既然低落，我们才要在低落的时候。"},{"start":1604.04,"end":1605.88,"text":"为什么这个就是我们行业不好，"},{"start":1606.2,"end":1608.44,"text":"也是一个因素要现在才投。"},{"start":1609.96,"end":1614.84,"text":"如果大家都认识到这是，他整个估值整体"},{"start":1614.84,"end":1615.88,"text":"的估值上去了，"},{"start":1617.8,"end":1622.04,"text":"你你你你投资就有点麻烦。"},{"start":1622.68,"end":1625.8,"text":"没有现在，我说投资非常容易。"},{"start":1627.0,"end":1629.88,"text":"然后我叫艾年，首先非常感谢您今天的分"},{"start":1629.88,"end":1632.12,"text":"享，也感谢您在网上的一些分享。"},{"start":1632.44,"end":1634.28,"text":"然后对于我们这些年轻人来说，"},{"start":1634.28,"end":1637.72,"text":"就能够接触到这些知识，或者能够在一开"},{"start":1637.72,"end":1640.04,"text":"始经历一些比较好的投资观念，很受益。"},{"start":1640.04,"end":1642.36,"text":"所以说可以先跟你说一下，非常的感谢您，"},{"start":1642.68,"end":1644.92,"text":"啊，向您很好的分享，然后我们可以多看"},{"start":1644.92,"end":1645.32,"text":"到一点。"},{"start":1645.64,"end":1647.32,"text":"然后今天是带着两个问题来的，"},{"start":1647.32,"end":1650.2,"text":"想跟那个林老师请教一下。"},{"start":1650.04,"end":1653.88,"text":"下，就是第一个问题，就是对于我们年轻"},{"start":1653.88,"end":1656.76,"text":"人来说啊，可能就是没有那么多钱，"},{"start":1656.92,"end":1659.32,"text":"然后买林老师的股票，虽然我在努力的攒"},{"start":1659.32,"end":1662.12,"text":"钱，以后买你的，买你的那个产品。"},{"start":1662.52,"end":1663.0,"text":"对。"},{"start":1663.08,"end":1666.76,"text":"然后那么在这个情况下呢，就是您对我们"},{"start":1666.76,"end":1669.24,"text":"就是像这种年轻人刚毕业一年，"},{"start":1669.64,"end":1673.08,"text":"然后这些年轻人，您有什么建议可以给我"},{"start":1673.16,"end":1673.56,"text":"们吗？"},{"start":1675.64,"end":1677.96,"text":"我干这个的，我建议你啥不要炒股，"},{"start":1678.44,"end":1678.52,"text":"是"},{"start":1680.36,"end":1680.76,"text":"啊，我"},{"start":1682.84,"end":1685.0,"text":"觉得这个行业是最好的，对不对？"},{"start":1686.52,"end":1687.88,"text":"虽然大家现在骂，"},{"start":1689.0,"end":1691.72,"text":"都在骂股市，我不骂，我觉得好。"},{"start":1693.48,"end":1695.96,"text":"嗯，就是那第二个问题，就是想问一下老"},{"start":1695.96,"end":1699.64,"text":"师，那就我其实，哎也不是说第二个问题，"},{"start":1699.88,"end":1702.52,"text":"你看第一个问题，就是在这种情况下，"},{"start":1702.52,"end":1705.72,"text":"我应该，就是我们年轻人应该怎么去，"},{"start":1705.72,"end":1709.32,"text":"就是选择一些，嗯哪些公司，我们怎么去"},{"start":1709.32,"end":1712.44,"text":"看呢？他是觉得是一个比较有价值的公司，"},{"start":1712.44,"end":1715.08,"text":"怎么去从一个大的，就是方向里面，"},{"start":1715.16,"end":1718.28,"text":"这么多家公司里面，我能够去找到有哪些"},{"start":1718.28,"end":1721.16,"text":"思路可以去找到哪些是有价值的公司呢？"},{"start":1723.48,"end":1724.6,"text":"这个是这样的啊，"},{"start":1725.88,"end":1728.44,"text":"因为我这个人啊，我看别人都是不行。"},{"start":1730.76,"end":1734.36,"text":"所以就是，你要让我说，那我就是你应该"},{"start":1734.36,"end":1734.6,"text":"听。"},{"start":1736.52,"end":1740.2,"text":"啊，不要主观，主观的人生就这么几十年，"},{"start":1740.68,"end":1741.56,"text":"弯度很麻烦，"},{"start":1742.84,"end":1743.24,"text":"好吧？"},{"start":1743.88,"end":1746.04,"text":"因为我是个我很厉害，"},{"start":1748.12,"end":1751.48,"text":"我这个人非常厉害，我敢跟任何人去比他"},{"start":1751.48,"end":1755.0,"text":"的专业，你还是榜的第二，第一放在这里"},{"start":1755.16,"end":1756.04,"text":"就糟了。那就"},{"start":1757.16,"end":1757.64,"text":"是前面。今"},{"start":1759.56,"end":1763.08,"text":"天大家很熟，其实我也去再跟李老师学习，"},{"start":1763.08,"end":1764.28,"text":"说麻烦你帮我签个名。"},{"start":1766.6,"end":1769.36,"text":"然后再耽误一点时间，就是很珍惜这个提"},{"start":1769.42,"end":1770.12,"text":"问的机会。"},{"start":1770.2,"end":1773.56,"text":"就是第二点是，嗯，就是我们会接触到像"},{"start":1773.56,"end":1776.36,"text":"我会接触到各种各样的一些信息，"},{"start":1776.52,"end":1778.84,"text":"然后特别是有一些负面的信息，"},{"start":1778.84,"end":1781.72,"text":"对于社会、对于全球经济啊，或者各方面"},{"start":1781.72,"end":1786.44,"text":"那些负面信息，我不知道该以怎样的态度"},{"start":1786.52,"end":1790.68,"text":"或者心态去面对社会上这些复杂的负面的"},{"start":1790.68,"end":1792.6,"text":"信息。那这个可能是你基因的，"},{"start":1794.6,"end":1795.4,"text":"基因的问题。"},{"start":1795.48,"end":1799.24,"text":"你你就爱听那些负面的，那你就以常识来"},{"start":1799.24,"end":1799.64,"text":"判断。"},{"start":1800.36,"end":1804.12,"text":"他说的那个是不是符合常识，好不好？"},{"start":1805.08,"end":1809.88,"text":"其实很多东西是常识。谢谢林老师。"},{"start":1810.52,"end":1811.24,"text":"嗯，感谢。"},{"start":1811.96,"end":1816.68,"text":"我特别感兴趣，就是然后林总刚才提了说"},{"start":1816.68,"end":1819.32,"text":"说用这些财务指标来判断。"},{"start":1819.64,"end":1822.28,"text":"在我看现在很多中药股啊，因为还没有走"},{"start":1822.28,"end":1824.6,"text":"出来吧，就说比如说同仁堂啊，"},{"start":1824.76,"end":1828.04,"text":"他们那个财务指标好像也不是很好看。"},{"start":1828.52,"end":1832.52,"text":"然后呢，我自己我看的话，像有些平台会"},{"start":1832.52,"end":1835.16,"text":"公布一些数据啊，那种十大或者二十大一"},{"start":1835.24,"end":1838.2,"text":"个新老血管那个中层中层牙的一个排行。"},{"start":1838.68,"end":1841.56,"text":"然后，但它有三有三个数据啊，"},{"start":1841.56,"end":1844.6,"text":"一个是公立医院机构，然后有一些是新下"},{"start":1844.68,"end":1848.84,"text":"新建药店，然后一些是网上的一些药店呐。"},{"start":1849.16,"end":1852.44,"text":"嗯，排名那是有有出入的呀。"},{"start":1852.44,"end":1855.32,"text":"比如你总判断的话，会对哪一块的那种数"},{"start":1855.32,"end":1857.88,"text":"据会更侧重一点呢？"},{"start":1857.88,"end":1861.64,"text":"可能你说这事啊，就是是你说了半天你的"},{"start":1861.64,"end":1864.2,"text":"问题，他们也明白。嗯。对。"},{"start":1864.2,"end":1865.4,"text":"就好，记住你说的啥。"},{"start":1865.88,"end":1868.36,"text":"我行了，我知道大概你说的意思了，"},{"start":1868.36,"end":1869.8,"text":"我给你简短的说一下，是吧？"},{"start":1870.44,"end":1873.8,"text":"呃，那么这些企业本身，我们说现在行业"},{"start":1873.8,"end":1876.2,"text":"宏观，就是现在这个龙头，这些，"},{"start":1876.44,"end":1878.28,"text":"至于龙头它没产生的。"},{"start":1879.88,"end":1884.04,"text":"啊，这个行业本身，相对于三十年以后或"},{"start":1884.04,"end":1887.64,"text":"者二十年以后，这个今天这个这个位置是"},{"start":1887.64,"end":1887.72,"text":"零。"},{"start":1889.8,"end":1892.52,"text":"就像我们一个，比如说汽车，是吧？"},{"start":1892.6,"end":1895.24,"text":"假如说我们一个汽车现在是个，"},{"start":1897.16,"end":1900.68,"text":"这个全深圳也就一百辆汽车的时候，"},{"start":1901.48,"end":1901.88,"text":"你去，"},{"start":1903.32,"end":1905.96,"text":"你去说它龙，生产汽车的龙头是吧？"},{"start":1906.76,"end":1907.16,"text":"对不对？"},{"start":1907.56,"end":1910.52,"text":"就像我来深圳的时候，最早是个中华造了"},{"start":1910.52,"end":1913.4,"text":"一个中华汽车，是个塑料的。"},{"start":1914.68,"end":1915.32,"text":"那个是吧？"},{"start":1915.32,"end":1919.24,"text":"你今天你你在那个时候，相当于那个时候"},{"start":1919.24,"end":1920.76,"text":"是造车也是零？"},{"start":1920.92,"end":1923.96,"text":"你怎么能知道这几十年以后现在出现那个"},{"start":1923.96,"end":1924.76,"text":"啥品牌啊？"},{"start":1925.8,"end":1927.32,"text":"你今天提这个问题就是这个问题。"},{"start":1927.48,"end":1929.96,"text":"实际上它是需要跟踪的，对这些企业。"},{"start":1930.36,"end":1933.8,"text":"应该，我说的这个行业是非常大的，"},{"start":1934.36,"end":1935.4,"text":"它有可能。"},{"start":1936.6,"end":1939.48,"text":"今天这种就龙头，我们还看不到迹象。"},{"start":1940.2,"end":1942.68,"text":"因为大需求是在未来，"},{"start":1944.2,"end":1946.92,"text":"从零到一个巨无霸的过程。"},{"start":1947.8,"end":1949.72,"text":"你听懂我的意思了吗？嗯，听懂了。"},{"start":1949.8,"end":1951.48,"text":"啊，所以你你要，"},{"start":1952.76,"end":1956.44,"text":"我说是财务，只要去跟踪，因为我们现在"},{"start":1956.44,"end":1959.16,"text":"只要钱就这么多，我们在老师都都知道，"},{"start":1959.48,"end":1959.88,"text":"我们都"},{"start":1961.16,"end":1962.68,"text":"通过财务数据去跟踪。"},{"start":1965.8,"end":1969.32,"text":"嗯，然后看有些，就那数据比较平台啊，"},{"start":1969.32,"end":1971.8,"text":"他会公布这个，就是新浪、香港、"},{"start":1971.8,"end":1975.24,"text":"中盛要的一个前十前十的一个每年那个，"},{"start":1976.04,"end":1978.68,"text":"嗯，销售额一个总的就是排名排下来。"},{"start":1978.68,"end":1981.48,"text":"那你可以根据这些这些东西去。嗯。"},{"start":1981.56,"end":1982.52,"text":"跟踪也是。"},{"start":1984.12,"end":1986.28,"text":"但是它有是这种，就是大的单品的话，"},{"start":1986.28,"end":1990.12,"text":"比如说公立医院机构啊，那一个排名跟门"},{"start":1990.2,"end":1992.6,"text":"店呢，就是线下门店或者网上药店呢，"},{"start":1992.6,"end":1995.8,"text":"这个排名不一样，它也会有一些出入啊。"},{"start":1996.36,"end":1999.4,"text":"但是因为公立医院机构他们的一个销售额"},{"start":1999.4,"end":2003.88,"text":"会比线上或者线下药店金额会大很多，"},{"start":2004.44,"end":2007.72,"text":"但是你没有涉及到比如说一些营销费用啊"},{"start":2007.8,"end":2011.72,"text":"这种的话，就说这个大的单品的话，"},{"start":2011.72,"end":2014.28,"text":"会哪一块的数据会比比较准确一点，"},{"start":2014.36,"end":2017.0,"text":"是心像药。你可以参考嘛，对。"},{"start":2017.24,"end":2020.44,"text":"第二个，我们注重的是关键是它一，"},{"start":2021.8,"end":2023.72,"text":"药啊，肯定是药效疗"},{"start":2026.04,"end":2028.12,"text":"效。啊，疗效很重要的。"},{"start":2028.12,"end":2030.76,"text":"对，因为我不我不是学医的，我就对这上"},{"start":2030.76,"end":2031.4,"text":"不是很懂。"},{"start":2031.4,"end":2035.64,"text":"那你问问相关科室的医生，他们喜欢用啥？"},{"start":2035.96,"end":2038.84,"text":"是我在二零零三年到二零零六年，"},{"start":2040.04,"end":2042.76,"text":"嗯，报纸上公开发表的一些文章。"},{"start":2043.72,"end":2045.96,"text":"因为我当时有几家报纸啊、杂志，"},{"start":2046.04,"end":2047.32,"text":"他让我给他们做了个"},{"start":2048.84,"end":2051.72,"text":"做了个给我发了给我一个专栏。"},{"start":2053.16,"end":2055.16,"text":"啊，那么我就写了。"},{"start":2055.56,"end":2056.52,"text":"我当时我记得"},{"start":2057.8,"end":2057.96,"text":"把"},{"start":2059.16,"end":2063.08,"text":"当时这几年比如说写的当时节点不一样，"},{"start":2063.64,"end":2067.56,"text":"一些对一些主要的这个行业都做了评论。"},{"start":2067.8,"end":2072.52,"text":"今天去看，完全我说的都是今天具体实现"},{"start":2072.52,"end":2075.08,"text":"了，而且我还做了个一百万的那个，"},{"start":2077.88,"end":2078.92,"text":"就是"},{"start":2080.76,"end":2082.36,"text":"一百万的那个实盘。"},{"start":2082.76,"end":2085.56,"text":"我说买那种股票买多少买多少，具体都有。"},{"start":2086.04,"end":2088.2,"text":"哎，按照我这个涨不出一万，不中了，"},{"start":2088.28,"end":2088.6,"text":"随便买。"},{"start":2090.2,"end":2090.36,"text":"好。"},{"start":2091.0,"end":2092.6,"text":"你觉得我厉害不厉害？"},{"start":2093.0,"end":2094.68,"text":"我能看到二十年以上。"},{"start":2094.84,"end":2100.12,"text":"这个很简单，我这是这是有有记录的，"},{"start":2100.12,"end":2102.68,"text":"还有呢，电视节目，我就买这个，"},{"start":2102.76,"end":2103.24,"text":"就买这个，"},{"start":2105.08,"end":2105.96,"text":"那不是运气。"},{"start":2107.48,"end":2109.4,"text":"就像你今天听到我，如果说是，"},{"start":2109.72,"end":2112.12,"text":"我我把二十年以后的结果告诉你，"},{"start":2113.16,"end":2116.68,"text":"世界十大前十大医药公司，中国在五位。"},{"start":2116.84,"end":2117.0,"text":"对。"},{"start":2119.4,"end":2122.12,"text":"你如果信了，你就那一定是"},{"start":2123.4,"end":2124.76,"text":"翻天覆地的这个。"},{"start":2125.88,"end":2128.52,"text":"那当时有一，这些人也怕我骗子骗的，"},{"start":2128.84,"end":2131.24,"text":"因为我说的话就比较比较直接，"},{"start":2132.2,"end":2132.68,"text":"是吧？"},{"start":2133.48,"end":2134.52,"text":"我这个人抓住点。"},{"start":2137.96,"end":2141.4,"text":"他听不听不听，他听得刺耳，是吧？"},{"start":2142.52,"end":2145.08,"text":"他刺耳，你听了以后，你如果记错，"},{"start":2145.24,"end":2147.48,"text":"你按照我这个，你听话他就搞的话，"},{"start":2147.48,"end":2149.48,"text":"他就你能发财啊，你。"},{"start":2151.56,"end":2152.04,"text":"是吧？"},{"start":2152.68,"end":2155.32,"text":"你这个东西就是，我当时也说了，"},{"start":2155.4,"end":2157.88,"text":"我说我没说了都不是牛股，说不透。"},{"start":2159.64,"end":2162.76,"text":"那今天看看你这，对的，这打长期的牛股，"},{"start":2163.56,"end":2166.6,"text":"我做到一种，今天都还在，都是牛股，"},{"start":2167.88,"end":2168.84,"text":"还真没这个错。"},{"start":2170.04,"end":2174.12,"text":"因为今天这个时候，我们不能预测个股，"},{"start":2174.6,"end":2175.56,"text":"是吧？不能去做。"},{"start":2176.44,"end":2179.08,"text":"那你说我心里没数，我心里肯定有数。"},{"start":2179.08,"end":2181.0,"text":"我只是不愿意做，但是违规的，"},{"start":2182.52,"end":2184.6,"text":"当时反正没没人管得了你。"}]},"68":{"source_sha256":"81833e8aa7224716bd682b91e486ffcab5f4f2f4dc6fc00f8d523b08c59067dd","run_id":"35098194067","cues":[{"start":0.56,"end":1.2,"text":"首先感谢这"},{"start":2.48,"end":4.96,"text":"个呃，这个主办方给我这个机会啊，"},{"start":5.36,"end":7.36,"text":"就是我就"},{"start":8.56,"end":12.32,"text":"讲一下，就是实业是要做，但接下来我我"},{"start":12.32,"end":15.2,"text":"们想啊，大部分就像刚才那个老先生，"},{"start":15.92,"end":17.84,"text":"他这个实业以后可能都不好。"},{"start":18.56,"end":18.56,"text":"我"},{"start":19.92,"end":24.64,"text":"方向已经告诉你，为什么？"},{"start":24.64,"end":27.68,"text":"这个实业大部分呃，这个未来我我们说的"},{"start":27.68,"end":31.0,"text":"是未来可能二三十年以后啊，这个实业"},{"start":32.12,"end":34.52,"text":"是很难做的，赚不到钱。"},{"start":35.16,"end":38.28,"text":"我们做做买卖都是要赚钱，如果赚不到钱"},{"start":38.28,"end":40.92,"text":"的话，它只有一条出路，就是越做越差。"},{"start":42.84,"end":44.68,"text":"它不能越做越越越越大。"},{"start":45.24,"end":49.4,"text":"有这个事情，就是我们首先是不管做实业"},{"start":49.56,"end":51.8,"text":"还是我们做这个投机生意的、炒股的，"},{"start":52.28,"end":53.4,"text":"他都要注意这个周期。"},{"start":54.36,"end":55.24,"text":"为什么？就"},{"start":56.92,"end":60.6,"text":"是接下来可能三十年以后，中国人口要"},{"start":62.36,"end":62.68,"text":"减少。"},{"start":64.36,"end":65.8,"text":"现在大概有十三亿人。"},{"start":66.28,"end":68.92,"text":"我们就是现在有的，就是算了个账，"},{"start":68.92,"end":72.76,"text":"说是中国三十年以后人口要变成六到九亿。"},{"start":73.56,"end":74.36,"text":"那怎么办呢？"},{"start":74.6,"end":77.88,"text":"而且本身现在做实业的，这生产的产品都"},{"start":77.88,"end":78.52,"text":"是过剩型的，"},{"start":79.64,"end":82.6,"text":"全部都是过剩，基本上没有我们想要的，"},{"start":82.6,"end":83.8,"text":"就是供不应求的东西。"},{"start":84.6,"end":86.52,"text":"供不应求也是暂时性的。"},{"start":88.12,"end":88.36,"text":"那怎么"},{"start":90.04,"end":92.44,"text":"啊，一个这个，就人口变少。"},{"start":92.6,"end":95.4,"text":"它，你不管什么互联网、什么各种，"},{"start":95.4,"end":98.52,"text":"现在包括这新经济，你最终都是要人去支"},{"start":98.52,"end":98.76,"text":"撑的。"},{"start":99.16,"end":103.24,"text":"人少了没办法，它只消费少，啊，"},{"start":103.32,"end":105.64,"text":"包括吃的、那个喝的这些都要少。"},{"start":106.92,"end":110.36,"text":"这我们说的就是一种人，人口这个这个，"},{"start":112.12,"end":112.84,"text":"就按照现在"},{"start":114.04,"end":116.92,"text":"这个这个发展趋势啊，那就是这种情况。"},{"start":117.8,"end":120.36,"text":"因为像我们这一代，如果家里有三个小孩"},{"start":120.44,"end":121.48,"text":"的，这一死，"},{"start":124.28,"end":126.76,"text":"这个他计划生育有个空空档期，"},{"start":127.56,"end":128.44,"text":"这个就比较麻烦。"},{"start":129.48,"end":131.0,"text":"那我们怎么想"},{"start":132.92,"end":135.24,"text":"呢？所以未来的投资方向，我这个不同意。"},{"start":135.72,"end":139.0,"text":"就是我们也不能说是把，我现在把把这个"},{"start":139.0,"end":141.48,"text":"资产都卖了，放到家里存着现金，"},{"start":141.88,"end":142.44,"text":"那也不对。"},{"start":143.08,"end":146.68,"text":"那我那我就不是说是这个可能也是对的，"},{"start":147.4,"end":149.08,"text":"但就是我们个人做不到。"},{"start":150.36,"end":152.6,"text":"那个东西，不要说叫什么企业家，"},{"start":153.08,"end":155.48,"text":"你你放还多少个亿放在那里，你把你资产"},{"start":155.48,"end":157.16,"text":"的百分之八十都换成现金。"},{"start":158.52,"end":161.88,"text":"他一天可能睡更睡不着觉，他是想发展。"},{"start":162.92,"end":165.4,"text":"但是现实告诉我们，可能接下来，"},{"start":166.36,"end":168.2,"text":"就是大部分企业都是不行。"},{"start":170.12,"end":173.16,"text":"那么我们就是作为我这个炒股的，"},{"start":174.12,"end":177.24,"text":"我就是保住我现在这个财产是首先是第一"},{"start":177.24,"end":179.16,"text":"的啊，不要变少。"},{"start":180.68,"end":182.76,"text":"那只能说是做这个死人的生意。"},{"start":184.44,"end":186.52,"text":"就我们这一代人，大概"},{"start":187.88,"end":189.08,"text":"再能活个三十多岁。"},{"start":191.0,"end":192.76,"text":"就这未来这三十年，"},{"start":193.96,"end":196.84,"text":"死人的生意，那么就是只有"},{"start":198.36,"end":200.36,"text":"医疗，还有医药，"},{"start":201.64,"end":202.28,"text":"医疗服务。"},{"start":204.04,"end":208.2,"text":"这个产业，这个会庞大，会壮大，"},{"start":208.68,"end":212.44,"text":"在这上面，这个投资的话，是，"},{"start":214.52,"end":217.4,"text":"就是说赚钱的机会是确定"},{"start":218.52,"end":218.6,"text":"的。"},{"start":219.16,"end":219.4,"text":"为什么？"},{"start":219.88,"end":222.28,"text":"现在中国人口，包括全世界的人口，"},{"start":222.28,"end":226.04,"text":"它这个老龄化，它会是这个"},{"start":227.96,"end":228.92,"text":"老龄化以后。"},{"start":230.44,"end":232.36,"text":"这个我昨天晚上没睡好。"},{"start":236.36,"end":236.36,"text":"啊，"},{"start":238.6,"end":238.92,"text":"他这"},{"start":241.48,"end":243.56,"text":"比如说七十、七十九岁和八十岁，"},{"start":244.12,"end":247.32,"text":"他可能七十九岁、八十岁这个这个人这一"},{"start":247.32,"end":250.76,"text":"年，七十九到八十年，八八十岁这一年啊，"},{"start":251.16,"end":256.44,"text":"他在这个医医药或者这个他医疗服务上花"},{"start":256.44,"end":259.24,"text":"的钱，是前七十九年的总和多少不是？"},{"start":259.8,"end":262.12,"text":"整天，我看我母亲整天现在吃饭，"},{"start":262.6,"end":263.72,"text":"几种药先吃了吧，"},{"start":265.16,"end":267.24,"text":"没办法，这个是必须的。"},{"start":267.56,"end":270.44,"text":"咱们现在活活得长，不是没有从别的原因，"},{"start":270.84,"end":271.64,"text":"就是因为。"},{"start":273.0,"end":273.16,"text":"它这"},{"start":274.44,"end":276.44,"text":"个啊，靠药物来都维持。"},{"start":278.28,"end":281.24,"text":"让你活得长，所以这个行业是肯定是要这"},{"start":281.24,"end":282.2,"text":"个大的发展。"},{"start":282.92,"end":285.08,"text":"再一个，我们看，就是。"},{"start":286.6,"end":289.0,"text":"全世界的医药企业，大的企业，"},{"start":290.2,"end":293.48,"text":"世界五百强的医药企业大概占了一大部"},{"start":295.08,"end":295.16,"text":"分。"},{"start":295.4,"end":298.92,"text":"就随便一个，就是就是世界五百强的医药"},{"start":299.0,"end":301.88,"text":"企业啊，比那瑞士银行市值，市值到大好"},{"start":301.88,"end":302.12,"text":"几倍。"},{"start":303.8,"end":306.36,"text":"但中国的医药企业现在目前最大的，"},{"start":306.36,"end":309.0,"text":"我们看就是恒瑞医药，才不到一千亿。"},{"start":310.36,"end":311.32,"text":"他们都是几万亿，"},{"start":313.64,"end":314.68,"text":"这个差距非常大。"},{"start":314.92,"end":317.08,"text":"所以中国的医药企业和医疗服务，"},{"start":317.16,"end":320.12,"text":"包括医院这些这些投资机会在未来"},{"start":321.48,"end":323.88,"text":"至少二十年会有很大的发展。"},{"start":324.84,"end":327.0,"text":"这个赚钱的确定性是非常高。"},{"start":328.2,"end":331.32,"text":"啊，所以我们我们现在就是所有的企业，"},{"start":331.72,"end":333.72,"text":"就是我们投资的这个这个公司，"},{"start":333.96,"end":335.8,"text":"所有的都是逐步卖出。"},{"start":338.04,"end":339.08,"text":"方向就是逐步卖出。"},{"start":339.48,"end":342.92,"text":"我现在也投资投资很多这个，呃，"},{"start":343.16,"end":344.6,"text":"就白酒啊，都是消费品。"},{"start":346.12,"end":346.76,"text":"那么我们"},{"start":348.2,"end":352.6,"text":"未来，就是说从现在开始，我对这些企业"},{"start":352.6,"end":353.4,"text":"只是会卖出，"},{"start":355.32,"end":357.4,"text":"不会买。这是给我自己定的纪律，"},{"start":358.92,"end":359.72,"text":"必须是卖出。"},{"start":360.68,"end":362.28,"text":"至于什么时候卖，我也看情况。"},{"start":363.4,"end":364.2,"text":"逐步都是卖出。"},{"start":366.04,"end":368.76,"text":"逐步就是我们投入的，在新投入的，"},{"start":369.56,"end":372.68,"text":"一定是，就是我刚才说的医疗、"},{"start":373.32,"end":375.16,"text":"医疗和医疗服"},{"start":376.84,"end":376.84,"text":"务。"},{"start":377.32,"end":379.88,"text":"啊，这就是就是我们说的。"},{"start":380.44,"end":383.88,"text":"那剩下的就是你，你就炒股，怎么说？"},{"start":383.88,"end":386.12,"text":"大家说这个炒股啊，你先怎么怎么，"},{"start":386.36,"end":388.04,"text":"就是，实际上方向很重要。"},{"start":388.84,"end":391.96,"text":"就把这方向定下来以以后，你就买这个这"},{"start":391.96,"end":393.72,"text":"个指数，都是不会错"},{"start":394.84,"end":394.92,"text":"的。"},{"start":395.64,"end":398.2,"text":"一买接下来就是，接下来就是你的坚持，"},{"start":401.0,"end":405.24,"text":"坚持一下，把这些东西拿着，最后都是肯"},{"start":405.24,"end":405.4,"text":"定。"},{"start":405.8,"end":409.0,"text":"我们分析啊，最后都赚得让你不敢相信。"},{"start":410.2,"end":414.76,"text":"中国人是很厉害的，制造业这是这这这这，"},{"start":414.76,"end":415.64,"text":"人多得很。"},{"start":416.92,"end":420.2,"text":"十年之内，中国这个医药企业一定要产产"},{"start":420.2,"end":421.32,"text":"生这个全世界的这个。"},{"start":424.44,"end":427.88,"text":"做到第一的，都你看现在抗生素中国已经"},{"start":427.88,"end":430.12,"text":"做到第一了，因为它需求量大，"},{"start":431.4,"end":432.2,"text":"需求量非常"},{"start":434.44,"end":437.8,"text":"大。啊，包括你这个这个这个。这个。"},{"start":439.72,"end":441.0,"text":"一些一些单单，"},{"start":442.36,"end":445.48,"text":"不是中国人搞的西药，也都做的好多药都"},{"start":445.48,"end":449.16,"text":"做到全世界第一，啊，只是他们这个这现"},{"start":449.16,"end":449.56,"text":"在中国"},{"start":450.6,"end":451.4,"text":"这个，这个就"},{"start":454.04,"end":456.6,"text":"是不是有序的竞争，现在没有形成这个这"},{"start":456.6,"end":459.4,"text":"个行业的寡头，所以它就是这个，"},{"start":460.12,"end":461.96,"text":"医药企业的效率是不好。"},{"start":463.96,"end":467.08,"text":"就大的方向我们定了以后，那么我们重点"},{"start":467.8,"end":468.76,"text":"选一些什么企业呢？"},{"start":469.88,"end":470.36,"text":"心血管，"},{"start":471.64,"end":472.44,"text":"第一心血管，"},{"start":473.48,"end":476.68,"text":"然后糖尿病，反正与心血管有关系的，"},{"start":477.24,"end":479.16,"text":"这个你都不会错，"},{"start":481.08,"end":481.96,"text":"用这个销量最大，"},{"start":483.64,"end":484.6,"text":"而且门槛也高。"},{"start":486.12,"end":487.72,"text":"啊，就把这些企业，"},{"start":488.92,"end":491.96,"text":"你看他去去去查一下他们生产什么药的，"},{"start":491.96,"end":495.16,"text":"反正和这些有关系的都要拿着。"},{"start":498.36,"end":500.12,"text":"好吧，我今天就讲这么多。"},{"start":501.24,"end":504.68,"text":"嗯，"},{"start":506.44,"end":507.56,"text":"讲多了就记不住。"},{"start":511.08,"end":512.76,"text":"哎呀，有点遗憾啊，李渊先生。"},{"start":513.24,"end":515.88,"text":"就昨天晚上他说没睡好，所以只讲这么多，"},{"start":515.88,"end":516.28,"text":"是吧？"},{"start":517.88,"end":519.8,"text":"啊，讲多记不住，没没给大家推荐几只什"},{"start":519.8,"end":520.6,"text":"么股票之类的。"},{"start":521.32,"end":524.92,"text":"啊，对对对对对哎呀，对对对，"},{"start":524.92,"end":525.88,"text":"大家看啊，掌声一点。"},{"start":526.12,"end":528.52,"text":"推荐股票，因为我是做基金的，"},{"start":529.08,"end":531.64,"text":"他这对这个行业啊，他有要求啊，"},{"start":531.64,"end":535.4,"text":"所以我们个股我们就不说了，就是就是投"},{"start":535.4,"end":536.76,"text":"资医药这些。"},{"start":537.16,"end":540.2,"text":"股票哪怕你不懂啊，你把上市公司所有的"},{"start":540.2,"end":543.96,"text":"这，给他平均，有一百万你都给他买买买"},{"start":543.96,"end":547.24,"text":"买过了，啊，这个每个行每一个这个这个"},{"start":547.4,"end":551.24,"text":"这个前排前一两名的你都给他买了，"},{"start":551.24,"end":553.4,"text":"把竞争对手都给干掉，都都都都，"},{"start":553.64,"end":556.52,"text":"把他竞争谁知道哪个哪个哪个不行不行，"},{"start":556.76,"end":557.16,"text":"你都给他。"},{"start":557.4,"end":560.6,"text":"就像老老先生做金博的，如果把金博的前"},{"start":560.68,"end":561.64,"text":"五名都给弄了，"},{"start":562.92,"end":565.8,"text":"你投资这个行业应该是对的。"},{"start":565.8,"end":569.0,"text":"啊，这里边有个技巧啊，就把它全部买。"},{"start":570.44,"end":570.84,"text":"笨人笨办"},{"start":573.64,"end":574.76,"text":"法，这就是啊。"},{"start":575.08,"end":575.8,"text":"就是我"},{"start":576.92,"end":578.52,"text":"我我讲的，不是说我个人要。"},{"start":579.8,"end":581.56,"text":"当然赚钱的路子很多，是吧？"},{"start":582.04,"end":583.48,"text":"我就保证我到"},{"start":585.16,"end":588.44,"text":"九十岁的时候，我在任何时候我都是个有"},{"start":588.52,"end":592.2,"text":"钱人。不要去做那些自己没把握的事。"},{"start":592.52,"end":595.64,"text":"我说的这个是，他一定赚钱的。"},{"start":595.64,"end":598.04,"text":"啊，我这一辈子我不认为我会有错，"},{"start":598.84,"end":600.2,"text":"一定是对的。"}]}}
