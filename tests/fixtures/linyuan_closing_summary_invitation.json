{
  "provenance": {
    "receipt_sha256": "0298bacb955c5b9f3a97ad0d98e7f68af09ad6b95f6d9e7648e141854aad5f16",
    "proof_transcript_sha256": "87205db1e8aaf4cf7000b01e67d27119b8414a944cd5de07f2a8ef67d8e8a49e",
    "scope": "Unmodified raw timed cues from the receipt-matching submitted file"
  },
  "cues": [
    {
      "start": 0.0,
      "end": 4.160000000000025,
      "text": "那您有想过说什么时候退休，或者是说休"
    },
    {
      "start": 4.160000000000025,
      "end": 4.480000000000018,
      "text": "息？"
    },
    {
      "start": 5.439999999999998,
      "end": 9.360000000000014,
      "text": "那我没想过，所以说我现在正才是真正开"
    },
    {
      "start": 9.360000000000014,
      "end": 12.800000000000011,
      "text": "始，真正开始。啊，对我们公司什么都是。"
    },
    {
      "start": 12.800000000000011,
      "end": 15.360000000000014,
      "text": "我们前两天我跟他们开会还在说，"
    },
    {
      "start": 15.439999999999998,
      "end": 17.680000000000007,
      "text": "我们现在是从零起点，零起点，"
    },
    {
      "start": 17.75999999999999,
      "end": 19.28000000000003,
      "text": "啊，真正开始啊。"
    },
    {
      "start": 19.75999999999999,
      "end": 21.75999999999999,
      "text": "那现在是二零一八年。"
    },
    {
      "start": 22.24000000000001,
      "end": 25.19999999999999,
      "text": "那其实朋友圈前两天有个段子特别火，"
    },
    {
      "start": 25.28000000000003,
      "end": 27.19999999999999,
      "text": "每个人都在晒自己十八岁的时候。"
    },
    {
      "start": 27.680000000000007,
      "end": 32.56,
      "text": "那正是因为，二零一八年所有的九零后都"
    },
    {
      "start": 32.56,
      "end": 33.360000000000014,
      "text": "已经成年了。"
    },
    {
      "start": 33.60000000000002,
      "end": 36.079999999999984,
      "text": "那么现在市场上面已经涌现出了一大批优"
    },
    {
      "start": 36.079999999999984,
      "end": 39.19999999999999,
      "text": "秀的九零后的基金经理，也有九零后的从"
    },
    {
      "start": 39.19999999999999,
      "end": 39.51999999999998,
      "text": "业者。"
    },
    {
      "start": 39.84000000000003,
      "end": 43.360000000000014,
      "text": "那你作为前辈，有没有什么话或者说有什"
    },
    {
      "start": 43.360000000000014,
      "end": 45.19999999999999,
      "text": "么建议给到九零后？"
    },
    {
      "start": 45.28000000000003,
      "end": 47.360000000000014,
      "text": "啊，只要他不犯错，都能走出成绩来。"
    },
    {
      "start": 47.84000000000003,
      "end": 50.24000000000001,
      "text": "但是这个人啊，这个股市有个规律，"
    },
    {
      "start": 50.80000000000001,
      "end": 53.68000000000001,
      "text": "你必须要有十五年以上，你才会不怕股市"
    },
    {
      "start": 53.75999999999999,
      "end": 53.75999999999999,
      "text": "的。"
    },
    {
      "start": 54.72000000000003,
      "end": 57.920000000000016,
      "text": "多数人他投资要要经过十五年的投资，"
    },
    {
      "start": 58.0,
      "end": 60.80000000000001,
      "text": "而且每次都要正确，能抓住每次都要抓住"
    },
    {
      "start": 60.879999999999995,
      "end": 61.360000000000014,
      "text": "大方向。"
    },
    {
      "start": 62.31999999999999,
      "end": 66.07999999999998,
      "text": "那么我们所所说的就是，投资人必须他拥"
    },
    {
      "start": 66.07999999999998,
      "end": 69.04000000000002,
      "text": "有三千万以上的这个门槛资金。"
    },
    {
      "start": 69.68,
      "end": 72.24000000000001,
      "text": "就是你怎么努力，你白手起家，"
    },
    {
      "start": 72.96000000000004,
      "end": 74.07999999999998,
      "text": "你要赚到钱的话，"
    },
    {
      "start": 75.28000000000003,
      "end": 77.44,
      "text": "都要需要十五年。"
    },
    {
      "start": 77.44,
      "end": 80.80000000000001,
      "text": "十五年啊，多数情况，这个三千万的目标"
    },
    {
      "start": 80.80000000000001,
      "end": 81.44,
      "text": "才会实现。"
    },
    {
      "start": 82.32,
      "end": 84.63999999999999,
      "text": "那呃，我们说的这个滚雪球这样的，"
    },
    {
      "start": 85.36000000000001,
      "end": 88.56,
      "text": "越滚越大，必须十五年是卖不了的卡。"
    },
    {
      "start": 89.12,
      "end": 91.19999999999999,
      "text": "十五年是卖不了。对我们身边都这样。"
    },
    {
      "start": 91.84000000000003,
      "end": 96.80000000000001,
      "text": "啊，那呃，如果说在，栏目的最后用一句"
    },
    {
      "start": 96.80000000000001,
      "end": 99.12,
      "text": "或者是几句话总结一下您的一个，"
    },
    {
      "start": 99.84000000000003,
      "end": 101.84000000000003,
      "text": "从业历程或者说您的一个心路历程。"
    }
  ]
}
