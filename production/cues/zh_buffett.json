{
  "clip_start_sec": 0.0,
  "clip_end_sec": 55.88,
  "duration_sec": 55.88,
  "lang": "zh",
  "cues": [
    {
      "start": 0.0,
      "end": 4.26,
      "zh": "巴菲特语录三十八。我不研究宏观问题。",
      "en": ""
    },
    {
      "start": 4.26,
      "end": 9.47,
      "zh": "投资中最紧要的是弄清什么事是重要的、可知的。",
      "en": ""
    },
    {
      "start": 9.47,
      "end": 14.68,
      "zh": "如果一件事是不重要的、不可知的，那就别管了。",
      "en": ""
    },
    {
      "start": 14.68,
      "end": 21.95,
      "zh": "曾博士解读。巴菲特曾经说，即使格林斯潘悄悄告诉我未来两年的货币政策，",
      "en": ""
    },
    {
      "start": 21.95,
      "end": 25.16,
      "zh": "我也不会改变我的任何一个行为。",
      "en": ""
    },
    {
      "start": 25.16,
      "end": 36.39,
      "zh": "因为，巴菲特的投资主要是穿越周期的，人们日常生活必不可少的、有很深呼成河的龙头品牌企业，而且通常一旦持有，",
      "en": ""
    },
    {
      "start": 36.39,
      "end": 43.39,
      "zh": "就远远跨越宏观经济周期，所以，短期经济政策变化和市场波动影响不大。",
      "en": ""
    },
    {
      "start": 43.39,
      "end": 45.72,
      "zh": "有所不为，才能有所为。",
      "en": ""
    },
    {
      "start": 45.72,
      "end": 53.44,
      "zh": "投资就要聚焦真正重要，可以掌握的部分，比如所投资企业及其竞争对手的经营状况，",
      "en": ""
    },
    {
      "start": 53.44,
      "end": 55.88,
      "zh": "所在行业的未来趋势等等。",
      "en": ""
    }
  ]
}